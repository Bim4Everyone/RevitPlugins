<Window
    x:Class="RevitVORChecker.Views.CheckProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    Width="560"
    Height="190"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarProgress" ProgressState="Normal" />
    </Window.TaskbarItemInfo>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="StepText"
            Grid.Row="0"
            Margin="0,0,0,6" />

        <ProgressBar
            x:Name="StepProgress"
            Grid.Row="1"
            Height="18"
            Minimum="0" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            Opacity="0.75"
            TextTrimming="CharacterEllipsis" />

        <Button
            x:Name="CancelButton"
            Grid.Row="4"
            Width="110"
            Padding="0,4"
            HorizontalAlignment="Right"
            Click="CancelButton_Click" />
    </Grid>
</Window>
