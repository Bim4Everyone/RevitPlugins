<core:WpfUIPlatformWindow
    x:Class="RevitDocumenter.Views.ApartmentDimensioningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:base="clr-namespace:dosymep.WPF.Views"
    xmlns:local="clr-namespace:RevitDocumenter.Views"
    xmlns:vms="clr-namespace:RevitDocumenter.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    
    xmlns:converters="clr-namespace:dosymep.WPF.Converters"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
   
    mc:Ignorable="d"
    Title="{me:LocalizationSource ApartmentDimensioningWindow.Title}"
    KeyDown="Window_KeyDown"
    
    Height="750"
    Width="630"
    
    MinHeight="750"
    MinWidth="630"
    d:DataContext="{d:DesignInstance vms:ApartmentDimensioningViewModel, IsDesignTimeCreatable=False}">
    <core:WpfUIPlatformWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadViewCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource RebarDimensioningWindow.Title}" />

        <Border
            Grid.Row="1"
            Margin="15 0 15 5"
            Style="{StaticResource CustomBorder}">
            <StackPanel>
                <ui:TextBlock
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    Text="{me:LocalizationSource RebarDimensioningWindow.FamilyNamePart}"
                    Style="{StaticResource CustomTextBlock}" />

                <!--<ui:TextBox
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Text="{Binding Path=FamilyNamePart, UpdateSourceTrigger=PropertyChanged}" />-->
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="2"
            Margin="0 0 10 10"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="5"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                x:Name="OkButton"
                Margin="5"
                Width="80"
                Appearance="Info"
                Content="Ok"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="5"
                Width="80"
                Content="Cancel"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>
