<core:WpfUIPlatformWindow
    x:Class="RevitDocumenter.Views.RoomDimensioningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vms="clr-namespace:RevitDocumenter.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"

    mc:Ignorable="d"
    Title="{me:LocalizationSource RoomDimensioningWindow.Title}"
    KeyDown="Window_KeyDown"

    Height="520"
    Width="760"

    MinHeight="420"
    MinWidth="600"
    d:DataContext="{d:DesignInstance vms:RoomDimensioningViewModel, IsDesignTimeCreatable=False}">
    <core:WpfUIPlatformWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:TextBlock
                x:Key="ColumnRoomType"
                Text="{me:LocalizationSource RoomDimensioningWindow.ColumnRoomType}" />
            <ui:TextBlock
                x:Key="ColumnPurposeValue"
                Text="{me:LocalizationSource RoomDimensioningWindow.ColumnPurposeValue}" />
            <ui:TextBlock
                x:Key="ColumnRoomCount"
                Text="{me:LocalizationSource RoomDimensioningWindow.ColumnRoomCount}" />
            <ui:TextBlock
                x:Key="ColumnDimensionType"
                Text="{me:LocalizationSource RoomDimensioningWindow.ColumnDimensionType}" />
            <ui:TextBlock
                x:Key="ColumnDimensionTypeFound"
                Text="{me:LocalizationSource RoomDimensioningWindow.ColumnDimensionTypeFound}" />
        </ResourceDictionary>
    </core:WpfUIPlatformWindow.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadViewCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource RoomDimensioningWindow.Title}" />

        <!-- Активный вид и файл настроек -->
        <Border
            Grid.Row="1"
            Margin="15 0 15 5"
            Style="{StaticResource CustomBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Text="{me:LocalizationSource RoomDimensioningWindow.ActiveView}"
                    Style="{StaticResource CustomTextBlock}" />
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    VerticalAlignment="Center"
                    Text="{Binding ActiveViewName}" />

                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Text="{me:LocalizationSource RoomDimensioningWindow.SettingsFile}"
                    Style="{StaticResource CustomTextBlock}" />
                <ui:TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    Text="{Binding SettingsPath, Mode=OneWay}" />
                <ui:Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="5"
                    Width="100"
                    Content="{me:LocalizationSource RoomDimensioningWindow.Browse}"
                    Command="{Binding BrowseSettingsCommand}" />

                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0 5"
                    Content="{me:LocalizationSource RoomDimensioningWindow.DebugMode}"
                    IsEnabled="{Binding IsSettingsLoaded}"
                    IsChecked="{Binding DebugMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ui:TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    Foreground="Orange"
                    TextWrapping="Wrap"
                    Text="{Binding SettingsErrorText}" />
            </Grid>
        </Border>

        <!-- Сводка по типам помещений -->
        <Border
            Grid.Row="2"
            Margin="15 5 15 5"
            Style="{StaticResource CustomBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock
                    Grid.Row="0"
                    Margin="5"
                    Text="{me:LocalizationSource RoomDimensioningWindow.RoomTypes}"
                    Style="{StaticResource CustomTextBlock}" />

                <ui:DataGrid
                    Grid.Row="1"
                    Margin="5"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    Style="{StaticResource CustomResizableDataGridStyle}"
                    ItemsSource="{Binding RoomTypeSummaries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding RoomTypeName}"
                            Header="{StaticResource ColumnRoomType}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding PurposeValue}"
                            Header="{StaticResource ColumnPurposeValue}" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding RoomCount}"
                            Header="{StaticResource ColumnRoomCount}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding DimensionTypeName}"
                            Header="{StaticResource ColumnDimensionType}" />
                        <DataGridCheckBoxColumn
                            Width="Auto"
                            IsReadOnly="True"
                            Binding="{Binding DimensionTypeFound, Mode=OneWay}"
                            Header="{StaticResource ColumnDimensionTypeFound}" />
                    </DataGrid.Columns>
                </ui:DataGrid>

                <StackPanel
                    Grid.Row="2"
                    Margin="5"
                    Orientation="Horizontal">
                    <ui:TextBlock
                        Text="{me:LocalizationSource RoomDimensioningWindow.RoomCount}" />
                    <ui:TextBlock
                        Margin="5 0 20 0"
                        Text="{Binding TotalRoomCount}" />
                    <ui:TextBlock
                        Text="{me:LocalizationSource RoomDimensioningWindow.UnmatchedRoomCount}" />
                    <ui:TextBlock
                        Margin="5 0 0 0"
                        Text="{Binding UnmatchedRoomCount}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="3"
            Margin="0 0 10 10"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="5"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                x:Name="OkButton"
                Margin="5"
                Width="80"
                Appearance="Info"
                Content="{me:LocalizationSource RoomDimensioningWindow.ButtonOk}"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="5"
                Width="80"
                Content="{me:LocalizationSource RoomDimensioningWindow.ButtonCancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>
