    <system:String x:Key="Parameters.Title">Parameter settings</system:String>
    <system:String x:Key="Parameters.Intro">Enter parameter names. The same name is used on the slab and frame for copying. Settings are saved with OK on the main screen.</system:String>
    <system:String x:Key="Parameters.Default">Default: {0}</system:String>
    <system:String x:Key="Parameters.Reset">Reset</system:String>
    <system:String x:Key="Parameters.ResetAll">Reset all</system:String>
    <system:String x:Key="Parameters.LongRebarCode.Title">Longitudinal bar class</system:String>
    <system:String x:Key="Parameters.LongRebarCode.Description">Class code of longitudinal bars. A500C currently uses code 501.</system:String>
    <system:String x:Key="Parameters.LongRebarDiameterTop.Title">Top longitudinal bar diameter</system:String>
    <system:String x:Key="Parameters.LongRebarDiameterTop.Description">Diameter of the two top bars; uses the diameter selected in the main window.</system:String>
    <system:String x:Key="Parameters.LongRebarDiameterBottom.Title">Bottom longitudinal bar diameter</system:String>
    <system:String x:Key="Parameters.LongRebarDiameterBottom.Description">Diameter of the two bottom bars; uses the same selected diameter.</system:String>
    <system:String x:Key="Parameters.StirrupCode.Title">Stirrup class</system:String>
    <system:String x:Key="Parameters.StirrupCode.Description">Selected stirrup class code: A240 = 240; A500C = 501.</system:String>
    <system:String x:Key="Parameters.WidthStep.Title">Longitudinal bar spacing across width</system:String>
    <system:String x:Key="Parameters.WidthStep.Description">Frame width minus stirrup and longitudinal bar diameters. Also used to locate the frame.</system:String>
    <system:String x:Key="Parameters.HeightStep.Title">Longitudinal bar spacing in height</system:String>
    <system:String x:Key="Parameters.HeightStep.Description">Vertical spacing calculated from slab thickness, covers and bar diameters.</system:String>
    <system:String x:Key="Parameters.AnchorageTop1.Title">Top anchorage, end 1</system:String>
    <system:String x:Key="Parameters.AnchorageTop1.Description">Length of the first anchorage of the top longitudinal bars.</system:String>
    <system:String x:Key="Parameters.AnchorageTop2.Title">Top anchorage, end 2</system:String>
    <system:String x:Key="Parameters.AnchorageTop2.Description">Length of the second anchorage of the top longitudinal bars.</system:String>
    <system:String x:Key="Parameters.AnchorageBottom1.Title">Bottom anchorage, end 1</system:String>
    <system:String x:Key="Parameters.AnchorageBottom1.Description">Length of the first anchorage of the bottom longitudinal bars.</system:String>
    <system:String x:Key="Parameters.AnchorageBottom2.Title">Bottom anchorage, end 2</system:String>
    <system:String x:Key="Parameters.AnchorageBottom2.Description">Length of the second anchorage of the bottom longitudinal bars.</system:String>
    <system:String x:Key="Parameters.StirrupChangeBinding.Title">Change stirrup binding</system:String>
    <system:String x:Key="Parameters.StirrupChangeBinding.Description">Family control switch. The plugin writes 1; its meaning must match the original family.</system:String>
