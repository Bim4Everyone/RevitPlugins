    <system:String x:Key="Parameters.StirrupDiameter.Description">Stirrup diameter selected in the main window.</system:String>
    <system:String x:Key="Parameters.StirrupBendLength.Title">Stirrup bend length</system:String>
    <system:String x:Key="Parameters.StirrupBendLength.Description">Stirrup bend length entered by the user.</system:String>
    <system:String x:Key="Parameters.StirrupStep.Title">Stirrup spacing</system:String>
    <system:String x:Key="Parameters.StirrupStep.Description">Distance between stirrups along the frame.</system:String>
    <system:String x:Key="Parameters.StirrupCount.Title">Stirrup count</system:String>
    <system:String x:Key="Parameters.StirrupCount.Description">Frame length / stirrup spacing + 1. Requires a writable Number parameter stored as Double.</system:String>
    <system:String x:Key="Parameters.KrGroup.Title">KR frame group</system:String>
    <system:String x:Key="Parameters.KrGroup.Description">Writes the foundation or floor punching-rebar group according to the selected slab.</system:String>
