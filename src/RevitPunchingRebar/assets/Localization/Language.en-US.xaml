    <system:String x:Key="Parameters.ConsumptionMark.Description">Copies the slab value into the frame for rebar consumption schedules.</system:String>
    <system:String x:Key="Parameters.OrgLevel.Title">Organizational level</system:String>
    <system:String x:Key="Parameters.OrgLevel.Description">Copies the organizational classification from the slab into the frame.</system:String>
