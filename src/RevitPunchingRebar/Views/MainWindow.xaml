<core:WpfUIPlatformWindow
    x:Class="RevitPunchingRebar.Views.MainWindow"
    x:Name="mainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:base="clr-namespace:dosymep.WPF.Views"
    xmlns:local="clr-namespace:RevitPunchingRebar.Views"
    xmlns:vms="clr-namespace:RevitPunchingRebar.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
   
    mc:Ignorable="d"
    Title="{me:LocalizationSource MainWindow.Title}"
    
    Height="600"
    Width="700"
    
    MinHeight="600"
    MinWidth="700"
   
    d:DataContext="{d:DesignInstance vms:MainViewModel, IsDesignTimeCreatable=False}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadViewCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <Style TargetType="Border" x:Key="uiBorder">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="14 8 14 8"/>
            <Setter Property="Margin" Value="8 0 8 0"/>
        </Style>
        
        <Style TargetType="ui:TextBlock" x:Key="groupName">
            <Setter Property="Margin" Value="8 8 0 8"/>
        </Style>

        <Style TargetType="ui:TextBlock" x:Key="itemName">
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="itemCB">
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource MainWindow.Title}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel 
                Grid.Column="0"
                Orientation="Vertical">
                
                <ui:TextBlock
                    Style="{StaticResource groupName}"
                    Text="{me:LocalizationSource MainWindow.GeneralSettings}"/>

                <Border Style="{StaticResource uiBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <ui:TextBlock 
                            Grid.Column="0"
                            Grid.Row="0"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.PylonsFromModel}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="1"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.PylonsFromLink}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="2"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.SelectedPylons}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="3"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.Slab}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="4"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.SlabSelected}"/>



                        <ui:Button
                            Grid.Column="1"
                            Grid.Row="0"
                            Content="{me:LocalizationSource MainWindow.ButtonSelect}"
                            Width="150"
                            Height="30"
                            Command="{Binding SelectPylonsFromModelCommand}"
                            CommandParameter="{Binding ElementName=mainWindow}"/>

                        <ui:Button
                            Grid.Column="1"
                            Grid.Row="1"
                            Content="{me:LocalizationSource MainWindow.ButtonSelect}"
                            Width="150"
                            Height="30"
                            Command="{Binding SelectPylonsFromLinkCommand}"
                            CommandParameter="{Binding ElementName=mainWindow}"/>

                        <TextBlock
                            Grid.Column="1"
                            Grid.Row="2">
                            <Run Text="{Binding SelectedPylonsCount, Mode=OneWay}" /> (<Run Text="{DynamicResource MainWindow.FromModel}" /> <Run Text="{Binding PylonsFromModelCount, Mode=OneWay}" />, <Run Text="{DynamicResource MainWindow.FromLink}" /> <Run Text="{Binding PylonsFromLinkCount, Mode=OneWay}" />)
                        </TextBlock>

                        <ui:Button
                            Grid.Column="1"
                            Grid.Row="3"
                            Content="{me:LocalizationSource MainWindow.ButtonSelect}"
                            Width="150"
                            Height="30"
                            Command="{Binding SelectSlabCommand}"
                            CommandParameter="{Binding ElementName=mainWindow}"/>

                        <TextBlock
                            Grid.Column="1"
                            Grid.Row="4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource MainWindow.No}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSlabSelected}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource MainWindow.Yes}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <ui:TextBlock
                    Style="{StaticResource groupName}"
                    Text="{me:LocalizationSource MainWindow.SlabRebar}"/>

                <Border Style="{StaticResource uiBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="0"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.RebarDiameter}"/>

                        <RadioButton
                            Grid.Column="0"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Content="{me:LocalizationSource MainWindow.RebarCoverFromSlab}"
                            GroupName="1"
                            IsChecked="{Binding IsRebarCoverFromSlab}"/>

                        <RadioButton
                            Grid.Column="0"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Content="{me:LocalizationSource MainWindow.RebarCoverFromUser}"
                            GroupName="1"
                            IsChecked="{Binding IsRebarCoverFromUser}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="3"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.RebarCoverTop}"
                            IsEnabled="{Binding IsRebarCoverFromUser}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="4"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.RebarCoverBottom}"
                            IsEnabled="{Binding IsRebarCoverFromUser}"/>





                        <ComboBox
                            Grid.Column="1"
                            Grid.Row="0"
                            ItemsSource="{Binding RebarDiameters}"
                            SelectedItem="{Binding SelectedSlabRebarDiameter}"/>
                        
                        <ui:TextBox
                            Grid.Column="1"
                            Grid.Row="3"
                            IsEnabled="{Binding IsRebarCoverFromUser}"
                            Text="{Binding RebarCoverTop}"/>

                        <ui:TextBox
                            Grid.Column="1"
                            Grid.Row="4"
                            IsEnabled="{Binding IsRebarCoverFromUser}"
                            Text="{Binding RebarCoverBottom}"/>
                    </Grid>
                </Border>



            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Vertical">
                
                <ui:TextBlock
                    Style="{StaticResource groupName}"
                    Text="{me:LocalizationSource MainWindow.FrameRebar}"/>

                <Border Style="{StaticResource uiBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="0"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.FamilyName}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="1"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.FamilyType}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="2"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.StirrupDiameter}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="3"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.StirrupRebarClass}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="4"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.StirrupStep}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="5"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.FrameWidth}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="6"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.StirrupBendLength}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="7"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.LongRebarDiameter}"/>

                        <ui:TextBlock
                            Grid.Column="0"
                            Grid.Row="8"
                            Style="{StaticResource itemName}"
                            Text="{me:LocalizationSource MainWindow.LongRebarAnchorageLength}"/>



                        <ComboBox
                            Grid.Column="1"
                            Grid.Row="0"
                            ItemsSource="{Binding FamilyNames}"
                            SelectedItem="{Binding SelectedFamilyName}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding LoadFamilyTypesCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                        
                        <ComboBox
                            Grid.Column="1"
                            Grid.Row="1"
                            ItemsSource="{Binding FamilyTypes}"
                            SelectedItem="{Binding SelectedFamilyType}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CheckFrameTypeCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                        <ComboBox
                            Grid.Column="1"
                            Grid.Row="2"
                            ItemsSource="{Binding RebarDiameters}"
                            SelectedItem="{Binding SelectedStirrupDiameter}"/>

                        <ComboBox
                            Grid.Column="1"
                            Grid.Row="3"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Value"
                            ItemsSource="{Binding RebarClasses}"
                            SelectedValue="{Binding SelectedRebarClass}"/>

                        <ui:TextBox
                            Grid.Column="1"
                            Grid.Row="4"
                            Text="{Binding StirrupStep}"/>
                        
                        <ui:TextBox
                            Grid.Column="1"
                            Grid.Row="5"
                            Text="{Binding FrameWidth}"/>

                        <ui:TextBox
                            Grid.Column="1"
                            Grid.Row="6"
                            Text="{Binding StirrupBendLength}"/>

                        <ComboBox
                            Grid.Column="1"
                            Grid.Row="7"
                            ItemsSource="{Binding RebarDiameters}"
                            SelectedItem="{Binding SelectedLongRebarDiameter}"/>

                        <ui:TextBox
                            Grid.Column="1"
                            Grid.Row="8"
                            Text="{Binding LongRebarAnchorageLength}"/>

                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="10"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                Margin="10"
                Width="80"
                Appearance="Info"
                Content="{me:LocalizationSource MainWindow.ButtonOk}"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="10"
                Width="80"
                Content="{me:LocalizationSource MainWindow.ButtonCancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>