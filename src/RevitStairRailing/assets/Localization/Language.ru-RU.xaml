<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="MainWindow.Title">Ограждение лестниц</system:String>

    <system:String x:Key="MainWindow.Preview">Схема: марш и площадка</system:String>
    <system:String x:Key="MainWindow.PreviewNote">Размеры в мм. Слева марш, справа площадка, у каждого своё крепление стоек. Пунктир — траектория (поверхность по оси ограждения). Красным выделяется то, что задаёт поле, в котором сейчас ввод.</system:String>
    <system:String x:Key="MainWindow.Trajectory">Положение относительно линий траектории (по ходу подъёма)</system:String>
    <system:String x:Key="MainWindow.SideLeft">Слева</system:String>
    <system:String x:Key="MainWindow.SideRight">Справа</system:String>
    <system:String x:Key="MainWindow.EdgeOffset">Отступ края опоры (пластины, щёк) от края марша, мм; меньше 0 — опора за краем, только при креплении сверху</system:String>
    <system:String x:Key="MainWindow.CreateAssembly">Собрать в сборку</system:String>
    <system:String x:Key="MainWindow.AssemblyName">Имя сборки (номер добавится)</system:String>

    <system:String x:Key="MainWindow.Posts">Стойки</system:String>
    <system:String x:Key="MainWindow.PostHeight">Высота до оси поручня, мм</system:String>
    <system:String x:Key="MainWindow.MaxPostStep">Наибольший шаг, мм</system:String>
    <system:String x:Key="MainWindow.PostRotation">Поворот сечения, °</system:String>
    <system:String x:Key="MainWindow.Handrail">Поручень</system:String>
    <system:String x:Key="MainWindow.Rods">Продольные прутки</system:String>
    <system:String x:Key="MainWindow.RodOffsets">Ниже оси поручня, мм (через «;»)</system:String>

    <system:String x:Key="MainWindow.NoPostType">Выберите типоразмер стоек.</system:String>
    <system:String x:Key="MainWindow.BadPostHeight">Высота стоек — положительное число.</system:String>
    <system:String x:Key="MainWindow.BadPostStep">Шаг стоек — положительное число.</system:String>
    <system:String x:Key="MainWindow.BadPostRotation">Поворот сечения стоек — число.</system:String>
    <system:String x:Key="MainWindow.NoHandrailType">Выберите типоразмер поручня.</system:String>
    <system:String x:Key="MainWindow.BadRodOffsets">Расстояния до прутков — числа через «;», больше 0 и меньше высоты стоек.</system:String>
    <system:String x:Key="MainWindow.NoRodType">Выберите типоразмер прутков.</system:String>
    <system:String x:Key="MainWindow.NoAnchorType">Выберите типоразмер анкеров.</system:String>
    <system:String x:Key="MainWindow.BadEdgeOffset">Отступ опоры от края — число; меньше 0 — только при креплении сверху на пластине.</system:String>
    <system:String x:Key="MainWindow.NoAssemblyName">Введите имя сборки.</system:String>

    <system:String x:Key="MainWindow.Mount">Крепление стоек</system:String>
    <system:String x:Key="MainWindow.FlightMount">На маршах</system:String>
    <system:String x:Key="MainWindow.LandingMount">На площадках</system:String>
    <system:String x:Key="MainWindow.PlateFamily">Семейство пластин</system:String>
    <system:String x:Key="MainWindow.BasePlate">Опорная пластина (крепление сверху)</system:String>
    <system:String x:Key="MainWindow.PlateLength">Длина вдоль, мм</system:String>
    <system:String x:Key="MainWindow.PlateWidth">Ширина, мм</system:String>
    <system:String x:Key="MainWindow.PlateThickness">Толщина, мм</system:String>
    <system:String x:Key="MainWindow.Anchors">Анкеры</system:String>
    <system:String x:Key="MainWindow.AnchorLayout">Расстановка</system:String>
    <system:String x:Key="MainWindow.AnchorEdge">От края, мм</system:String>
    <system:String x:Key="MainWindow.Cheeks">Щёки (крепление сбоку к закладной марша)</system:String>
    <system:String x:Key="MainWindow.CheekHeight">Высота, мм</system:String>
    <system:String x:Key="MainWindow.CheekGap">Зазор (стойка), мм</system:String>
    <system:String x:Key="MainWindow.CheekOrientation">Щёки</system:String>
    <system:String x:Key="Mount.Top">Сверху на пластине</system:String>
    <system:String x:Key="Mount.Side">Сбоку, щёки к закладной</system:String>
    <system:String x:Key="AnchorLayout.Triangle">3 треугольником</system:String>
    <system:String x:Key="AnchorLayout.Corners">4 по углам</system:String>
    <system:String x:Key="AnchorLayout.Diagonal">2 по диагонали</system:String>
    <system:String x:Key="CheekOrientation.Along">в плоскости ограждения</system:String>
    <system:String x:Key="CheekOrientation.Across">поперёк ограждения</system:String>
    <system:String x:Key="MainWindow.NoPlateFamily">Выберите семейство пластин (по линии, с параметрами типа «t» и «h»).</system:String>
    <system:String x:Key="MainWindow.BadBasePlate">Размеры опорной пластины — положительные числа.</system:String>
    <system:String x:Key="MainWindow.BadAnchorEdge">Отступ анкеров от края — не меньше 0 и не больше половины длины и ширины пластины.</system:String>
    <system:String x:Key="MainWindow.BadCheeks">Размеры щёк и зазор между ними — положительные числа.</system:String>
    <system:String x:Key="Build.PlateParameters">У семейства пластин нет параметров типа «t» (толщина) и «h» (ширина).</system:String>

    <system:String x:Key="Pick.Prompt">Выберите линии модели траектории ограждения (по краю маршей и площадок) и нажмите «Готово»</system:String>
    <system:String x:Key="Path.NoLines">Не выбрано ни одной линии модели.</system:String>
    <system:String x:Key="Path.NotLines">Траектория строится только по прямым линиям модели: среди выбранных есть дуги или сплайны.</system:String>
    <system:String x:Key="Path.Closed">Линии образуют замкнутый контур — у траектории должны быть начало и конец.</system:String>
    <system:String x:Key="Path.NotChain">Линии не образуют одну цепочку: концы соседних линий должны совпадать, без разрывов и ответвлений.</system:String>
    <system:String x:Key="Path.Vertical">Среди линий есть вертикальная — траектория идёт по маршам и площадкам в плане.</system:String>
    <system:String x:Key="Build.NoLevels">В модели нет уровней.</system:String>

    <system:String x:Key="MainWindow.ButtonOk">Выбрать линии и построить</system:String>
    <system:String x:Key="MainWindow.ButtonCancel">Отмена</system:String>
</ResourceDictionary>
