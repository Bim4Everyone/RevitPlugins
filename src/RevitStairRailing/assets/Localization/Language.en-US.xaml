<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="MainWindow.Title">Stair railing</system:String>

    <system:String x:Key="MainWindow.Preview">Scheme: flight and landing</system:String>
    <system:String x:Key="MainWindow.PreviewNote">Dimensions in mm. The flight is on the left, the landing on the right, each with its own post fixing. The dashed line is the path (surface along the railing axis). The part set by the field being edited is shown in red.</system:String>
    <system:String x:Key="MainWindow.Trajectory">Position relative to the path lines (going up)</system:String>
    <system:String x:Key="MainWindow.SideLeft">Left</system:String>
    <system:String x:Key="MainWindow.SideRight">Right</system:String>
    <system:String x:Key="MainWindow.EdgeOffset">Offset of the support edge (plate, cheeks) from the flight edge, mm; below 0 — beyond the edge, top fixing only</system:String>
    <system:String x:Key="MainWindow.CreateAssembly">Create assembly</system:String>
    <system:String x:Key="MainWindow.AssemblyName">Assembly name (number is appended)</system:String>

    <system:String x:Key="MainWindow.Posts">Posts</system:String>
    <system:String x:Key="MainWindow.PostHeight">Height to handrail axis, mm</system:String>
    <system:String x:Key="MainWindow.MaxPostStep">Maximum step, mm</system:String>
    <system:String x:Key="MainWindow.PostRotation">Cross-section rotation, °</system:String>
    <system:String x:Key="MainWindow.Handrail">Handrail</system:String>
    <system:String x:Key="MainWindow.Rods">Longitudinal rods</system:String>
    <system:String x:Key="MainWindow.RodOffsets">Below handrail axis, mm (separated by ";")</system:String>

    <system:String x:Key="MainWindow.NoPostType">Select the post type.</system:String>
    <system:String x:Key="MainWindow.BadPostHeight">Post height must be a positive number.</system:String>
    <system:String x:Key="MainWindow.BadPostStep">Post step must be a positive number.</system:String>
    <system:String x:Key="MainWindow.BadPostRotation">Post rotation must be a number.</system:String>
    <system:String x:Key="MainWindow.NoHandrailType">Select the handrail type.</system:String>
    <system:String x:Key="MainWindow.BadRodOffsets">Rod offsets must be numbers separated by ";", greater than 0 and less than the post height.</system:String>
    <system:String x:Key="MainWindow.NoRodType">Select the rod type.</system:String>
    <system:String x:Key="MainWindow.NoAnchorType">Select the anchor type.</system:String>
    <system:String x:Key="MainWindow.BadEdgeOffset">The support edge offset must be a number; below 0 only for top fixing on a plate.</system:String>
    <system:String x:Key="MainWindow.NoAssemblyName">Enter the assembly name.</system:String>

    <system:String x:Key="MainWindow.Mount">Post fixing</system:String>
    <system:String x:Key="MainWindow.FlightMount">On flights</system:String>
    <system:String x:Key="MainWindow.LandingMount">On landings</system:String>
    <system:String x:Key="MainWindow.PlateFamily">Plate family</system:String>
    <system:String x:Key="MainWindow.BasePlate">Base plate (top fixing)</system:String>
    <system:String x:Key="MainWindow.PlateLength">Length along, mm</system:String>
    <system:String x:Key="MainWindow.PlateWidth">Width, mm</system:String>
    <system:String x:Key="MainWindow.PlateThickness">Thickness, mm</system:String>
    <system:String x:Key="MainWindow.Anchors">Anchors</system:String>
    <system:String x:Key="MainWindow.AnchorLayout">Layout</system:String>
    <system:String x:Key="MainWindow.AnchorEdge">From edge, mm</system:String>
    <system:String x:Key="MainWindow.Cheeks">Cheek plates (side fixing to the flight embedded part)</system:String>
    <system:String x:Key="MainWindow.CheekHeight">Height, mm</system:String>
    <system:String x:Key="MainWindow.CheekGap">Gap (post), mm</system:String>
    <system:String x:Key="MainWindow.CheekOrientation">Cheeks</system:String>
    <system:String x:Key="Mount.Top">Top, on a plate</system:String>
    <system:String x:Key="Mount.Side">Side, cheeks to embedded part</system:String>
    <system:String x:Key="AnchorLayout.Triangle">3 in a triangle</system:String>
    <system:String x:Key="AnchorLayout.Corners">4 at corners</system:String>
    <system:String x:Key="AnchorLayout.Diagonal">2 diagonally</system:String>
    <system:String x:Key="CheekOrientation.Along">in the railing plane</system:String>
    <system:String x:Key="CheekOrientation.Across">across the railing</system:String>
    <system:String x:Key="MainWindow.NoPlateFamily">Select the plate family (line-based, with type parameters "t" and "h").</system:String>
    <system:String x:Key="MainWindow.BadBasePlate">Base plate dimensions must be positive numbers.</system:String>
    <system:String x:Key="MainWindow.BadAnchorEdge">Anchor edge distance must be from 0 to half of the plate length and width.</system:String>
    <system:String x:Key="MainWindow.BadCheeks">Cheek dimensions and the gap must be positive numbers.</system:String>
    <system:String x:Key="Build.PlateParameters">The plate family has no type parameters "t" (thickness) and "h" (width).</system:String>

    <system:String x:Key="Pick.Prompt">Select the model lines of the railing path (along flight and landing edges) and press Finish</system:String>
    <system:String x:Key="Path.NoLines">No model lines selected.</system:String>
    <system:String x:Key="Path.NotLines">The path is built from straight model lines only: the selection contains arcs or splines.</system:String>
    <system:String x:Key="Path.Closed">The lines form a closed loop — the path must have a start and an end.</system:String>
    <system:String x:Key="Path.NotChain">The lines do not form one chain: ends of adjacent lines must coincide, without gaps or branches.</system:String>
    <system:String x:Key="Path.Vertical">One of the lines is vertical — the path follows flights and landings in plan.</system:String>
    <system:String x:Key="Build.TransactionName">Stair railing: build</system:String>
    <system:String x:Key="Build.NoLevels">The model has no levels.</system:String>

    <system:String x:Key="MainWindow.ButtonOk">Select lines and build</system:String>
    <system:String x:Key="MainWindow.ButtonCancel">Cancel</system:String>
</ResourceDictionary>
