<core:WpfUIPlatformWindow
    x:Class="RevitStairRailing.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vms="clr-namespace:RevitStairRailing.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"

    mc:Ignorable="d"
    Title="{me:LocalizationSource MainWindow.Title}"

    Height="760"
    Width="1080"

    MinHeight="600"
    MinWidth="900"

    d:DataContext="{d:DesignInstance vms:MainViewModel, IsDesignTimeCreatable=False}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadViewCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <core:WpfUIPlatformWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </core:WpfUIPlatformWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource MainWindow.Title}" />

        <Grid
            Grid.Row="1"
            Margin="16,8"
            PreviewGotKeyboardFocus="Content_PreviewGotKeyboardFocus">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Схема пролёта, сторона и отступ, сборка -->
            <StackPanel Grid.Column="0">
                <TextBlock
                    Style="{StaticResource SectionHeader}"
                    Margin="0,0,0,6"
                    Text="{me:LocalizationSource MainWindow.Preview}" />
                <Border
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="4">
                    <Grid
                        Width="{Binding PreviewWidth}"
                        Height="{Binding PreviewHeight}">
                        <ItemsControl ItemsSource="{Binding Preview.Lines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line
                                        x:Name="PreviewLine"
                                        X1="{Binding X1}"
                                        Y1="{Binding Y1}"
                                        X2="{Binding X2}"
                                        Y2="{Binding Y2}"
                                        StrokeThickness="{Binding Thickness}"
                                        Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                            <Setter TargetName="PreviewLine" Property="StrokeDashArray" Value="6 4" />
                                            <Setter TargetName="PreviewLine" Property="Stroke"
                                                    Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter TargetName="PreviewLine" Property="Stroke" Value="Red" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Preview.Labels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        x:Name="PreviewLabel"
                                        FontSize="12"
                                        Text="{Binding Text}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter TargetName="PreviewLabel" Property="Foreground" Value="Red" />
                                            <Setter TargetName="PreviewLabel" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <TextBlock
                    Width="{Binding PreviewWidth}"
                    Margin="0,6,0,0"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Text="{me:LocalizationSource MainWindow.PreviewNote}" />

                <TextBlock
                    Style="{StaticResource SectionHeader}"
                    Text="{me:LocalizationSource MainWindow.Trajectory}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Tag="Trajectory"
                        Margin="0,0,16,0"
                        Content="{me:LocalizationSource MainWindow.SideLeft}"
                        IsChecked="{Binding IsLeftSide}" />
                    <RadioButton
                        Tag="Trajectory"
                        Content="{me:LocalizationSource MainWindow.SideRight}"
                        IsChecked="{Binding IsRightSide}" />
                </StackPanel>
                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource FieldLabel}"
                        Text="{me:LocalizationSource MainWindow.EdgeOffset}" />
                    <ui:TextBox
                        Tag="Trajectory"
                        Width="90"
                        HorizontalAlignment="Left"
                        Text="{Binding EdgeOffset, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox
                    Margin="0,12,0,6"
                    Content="{me:LocalizationSource MainWindow.CreateAssembly}"
                    IsChecked="{Binding CreateAssembly}" />
                <StackPanel
                    Orientation="Horizontal"
                    IsEnabled="{Binding CreateAssembly}">
                    <TextBlock
                        Style="{StaticResource FieldLabel}"
                        Text="{me:LocalizationSource MainWindow.AssemblyName}" />
                    <ui:TextBox
                        Width="200"
                        Text="{Binding AssemblyNamePrefix, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <!-- Состав и размеры -->
            <ScrollViewer
                Grid.Column="2"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Margin="0,0,0,6"
                        Text="{me:LocalizationSource MainWindow.Posts}" />
                    <ComboBox
                        Tag="Post"
                        Margin="0,0,0,6"
                        DisplayMemberPath="Name"
                        IsTextSearchEnabled="True"
                        TextSearch.TextPath="Name"
                        ItemsSource="{Binding FramingTypes}"
                        SelectedItem="{Binding PostType}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.PostHeight}" />
                        <ui:TextBox
                            Tag="PostHeight"
                            Grid.Row="0" Grid.Column="1"
                            Width="90"
                        HorizontalAlignment="Left"
                            Text="{Binding PostHeight, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="0" Grid.Column="3"
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.MaxPostStep}" />
                        <ui:TextBox
                            Tag="PostStep"
                            Grid.Row="0" Grid.Column="4"
                            Width="90"
                        HorizontalAlignment="Left"
                            Text="{Binding MaxPostStep, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.PostRotation}" />
                        <ui:TextBox
                            Tag="Post"
                            Grid.Row="2" Grid.Column="1"
                            Width="90"
                        HorizontalAlignment="Left"
                            Text="{Binding PostRotation, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{me:LocalizationSource MainWindow.Handrail}" />
                    <ComboBox
                        Tag="Handrail"
                        Margin="0,0,0,6"
                        DisplayMemberPath="Name"
                        IsTextSearchEnabled="True"
                        TextSearch.TextPath="Name"
                        ItemsSource="{Binding FramingTypes}"
                        SelectedItem="{Binding HandrailType}" />

                    <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{me:LocalizationSource MainWindow.Rods}" />
                    <ComboBox
                        Tag="Rods"
                        Margin="0,0,0,6"
                        DisplayMemberPath="Name"
                        IsTextSearchEnabled="True"
                        TextSearch.TextPath="Name"
                        ItemsSource="{Binding FramingTypes}"
                        SelectedItem="{Binding RodType}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.RodOffsets}" />
                        <ui:TextBox
                            Tag="Rods"
                            Width="220"
                            Text="{Binding RodOffsets, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock
                        Style="{StaticResource SectionHeader}"
                        Text="{me:LocalizationSource MainWindow.Mount}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.FlightMount}" />
                        <ComboBox
                            Tag="FlightMount"
                            Grid.Row="0" Grid.Column="1"
                            ItemsSource="{Binding MountOptions}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding FlightMount}" />
                        <TextBlock
                            Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.LandingMount}" />
                        <ComboBox
                            Tag="LandingMount"
                            Grid.Row="2" Grid.Column="1"
                            ItemsSource="{Binding MountOptions}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding LandingMount}" />
                        <TextBlock
                            Grid.Row="4" Grid.Column="0"
                            Style="{StaticResource FieldLabel}"
                            Text="{me:LocalizationSource MainWindow.PlateFamily}" />
                        <ComboBox
                            Tag="Plates"
                            Grid.Row="4" Grid.Column="1"
                            ItemsSource="{Binding PlateFamilies}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding PlateFamily}" />
                    </Grid>

                    <StackPanel IsEnabled="{Binding UsesTopMount}">
                        <TextBlock
                            Style="{StaticResource SectionHeader}"
                            Text="{me:LocalizationSource MainWindow.BasePlate}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="{me:LocalizationSource MainWindow.PlateLength}" />
                            <ui:TextBox
                                Tag="BasePlate"
                                Width="70"
                                Text="{Binding BasePlateLength, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Margin="12,0,8,0"
                                Text="{me:LocalizationSource MainWindow.PlateWidth}" />
                            <ui:TextBox
                                Tag="BasePlate"
                                Width="70"
                                Text="{Binding BasePlateWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Margin="12,0,8,0"
                                Text="{me:LocalizationSource MainWindow.PlateThickness}" />
                            <ui:TextBox
                                Tag="BasePlate"
                                Width="60"
                                Text="{Binding BasePlateThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox
                            Tag="Anchors"
                            Margin="0,10,0,6"
                            Content="{me:LocalizationSource MainWindow.Anchors}"
                            IsChecked="{Binding HasAnchors}" />
                        <StackPanel IsEnabled="{Binding HasAnchors}">
                            <ComboBox
                                Tag="Anchors"
                                Margin="0,0,0,6"
                                DisplayMemberPath="Name"
                                IsTextSearchEnabled="True"
                                TextSearch.TextPath="Name"
                                ItemsSource="{Binding AnchorTypes}"
                                SelectedItem="{Binding AnchorType}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="{me:LocalizationSource MainWindow.AnchorLayout}" />
                                <ComboBox
                                    Tag="Anchors"
                                    Width="200"
                                    ItemsSource="{Binding AnchorLayoutOptions}"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding AnchorLayout}" />
                                <TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Margin="12,0,8,0"
                                    Text="{me:LocalizationSource MainWindow.AnchorEdge}" />
                                <ui:TextBox
                                    Tag="Anchors"
                                    Width="60"
                                    Text="{Binding AnchorEdgeDistance, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsEnabled="{Binding UsesSideMount}">
                        <TextBlock
                            Style="{StaticResource SectionHeader}"
                            Text="{me:LocalizationSource MainWindow.Cheeks}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="{me:LocalizationSource MainWindow.CheekHeight}" />
                            <ui:TextBox
                                Tag="Cheeks"
                                Width="70"
                                Text="{Binding CheekHeight, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Margin="12,0,8,0"
                                Text="{me:LocalizationSource MainWindow.PlateWidth}" />
                            <ui:TextBox
                                Tag="Cheeks"
                                Width="70"
                                Text="{Binding CheekWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Margin="12,0,8,0"
                                Text="{me:LocalizationSource MainWindow.PlateThickness}" />
                            <ui:TextBox
                                Tag="Cheeks"
                                Width="60"
                                Text="{Binding CheekThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="{me:LocalizationSource MainWindow.CheekGap}" />
                            <ui:TextBox
                                Tag="Cheeks"
                                Width="60"
                                Text="{Binding CheekGap, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource FieldLabel}"
                                Margin="12,0,8,0"
                                Text="{me:LocalizationSource MainWindow.CheekOrientation}" />
                            <ComboBox
                                Tag="Cheeks"
                                Width="230"
                                ItemsSource="{Binding CheekOrientationOptions}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding CheekOrientation}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="8"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                Margin="8"
                Width="200"
                Appearance="Info"
                Content="{me:LocalizationSource MainWindow.ButtonOk}"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="8"
                Width="100"
                Content="{me:LocalizationSource MainWindow.ButtonCancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>
