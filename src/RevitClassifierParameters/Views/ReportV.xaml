<core:WpfUIPlatformWindow
    x:Class="RevitClassifierParameters.Views.ReportV"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:base="clr-namespace:dosymep.WPF.Views"
    xmlns:local="clr-namespace:RevitClassifierParameters.Views"
    xmlns:vms="clr-namespace:RevitClassifierParameters.ViewModels"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:markupExtensions="clr-namespace:RevitClassifierParameters.MarkupExtensions"

    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="{me:LocalizationSource ReportWindow.Title}"

    Height="450"
    Width="750"
    MinHeight="450"
    MinWidth="750"

    d:DataContext="{d:DesignInstance vms:ReportVM, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:TextBlock
                x:Key="ColumnStatusHeader"
                Text="{me:LocalizationSource ReportWindow.ColumnStatus}" />
            <ui:TextBlock
                x:Key="ColumnWorkCodeHeader"
                Text="{me:LocalizationSource ReportWindow.ColumnWorkCode}" />
            <ui:TextBlock
                x:Key="ColumnMaterialNameHeader"
                Text="{me:LocalizationSource ReportWindow.ColumnMaterialName}" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource ReportWindow.Title}"
            FontSize="16" />

        <Border
            Grid.Row="1"
            Margin="10 5 10 5"
            Style="{StaticResource CustomBorder}">

            <ui:DataGrid
                Style="{StaticResource CustomResizableDataGridStyle}"
                ItemsSource="{Binding
                     Path=ReportItems,
                     UpdateSourceTrigger=PropertyChanged,
                     Mode=TwoWay}">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Path=Status, Converter={markupExtensions:EnumToLocale}}"
                        Header="{StaticResource ColumnStatusHeader}"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Binding="{Binding Path=WorkCode}"
                        Header="{StaticResource ColumnWorkCodeHeader}"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Path=MaterialName}"
                        Header="{StaticResource ColumnMaterialNameHeader}"
                        IsReadOnly="True" />
                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <ui:Button
                Margin="10"
                Width="100"
                Appearance="Info"
                Content="{me:LocalizationSource ReportWindow.ButtonClose}"
                IsDefault="True"
                Click="ButtonForHide_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>
