<core:WpfUIPlatformWindow
    x:Class="RevitClassifierParameters.Views.ArParameterClassifierV"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:base="clr-namespace:dosymep.WPF.Views"
    xmlns:local="clr-namespace:RevitClassifierParameters.Views"
    xmlns:vms="clr-namespace:RevitClassifierParameters.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
   
    mc:Ignorable="d"
    Title="{me:LocalizationSource MainWindow.Title}"
    
    MinHeight="570"
    MinWidth="800"
   
    d:DataContext="{d:DesignInstance vms:ArParameterClassifierVM, IsDesignTimeCreatable=False}">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadViewCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource MainWindow.Title}" />

        <Border
            Grid.Row="1"
            Margin="10 5"
            Style="{StaticResource CustomBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5 5 5 0"
                    FontWeight="Bold"
                    Text="Файл с кодами классификатора" />                
                
                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5 0 5 5"
                    TextWrapping="Wrap"
                    Text="Необходимо выбрать актуальный для проекта excel-файл с кодами классификатора" />
                
                <ui:Button
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"                    
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Content="Выбрать"
                    Command="{Binding ReadExcelCommand}" />
            </Grid>
        </Border>
        
        <Border
            Grid.Row="2"
            Margin="10 5"
            Style="{StaticResource CustomBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5 5 5 0"
                    FontWeight="Bold"
                    Text="Кладка" />                
                
                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5 0 5 5"
                    TextWrapping="Wrap"
                    Text="Учитывает материалы с кодами, которые начинаются на г02.05" />
                
                <CheckBox
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"                    
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsChecked="{Binding Path=WorkWithMasonryCode}"/>
            </Grid>
        </Border>
            
        <Border
            Grid.Row="3"
            Margin="10 5"
            Style="{StaticResource CustomBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5 5 5 0"
                    FontWeight="Bold"
                    Text="Кровля" />                
                
                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5 0 5 5"
                    TextWrapping="Wrap"
                    Text="Учитывает материалы с кодами, которые начинаются на г02.06" />
                
                <CheckBox
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"                    
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsChecked="{Binding Path=WorkWithRoofCode}"/>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Margin="10 5"
            Style="{StaticResource CustomBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5 5 5 0"
                    FontWeight="Bold"
                    Text="Фасады" />                
                
                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5 0 5 5"
                    TextWrapping="Wrap"
                    Text="Учитывает материалы с кодами, которые начинаются на г02.07" />
                
                <CheckBox
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"                    
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsChecked="{Binding Path=WorkWithFacadeCode}"/>
                
                <ui:TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="5 5 5 0"
                    FontWeight="Bold"
                    Text="Заполнить тип фасада" />                
                
                <ui:TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="5 0 5 5"
                    TextWrapping="Wrap"
                    Text="Заполнить тип фасада в заданный параметр" />
                
                <CheckBox
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="1"      
                    Margin="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding Path=WorkWithFacadeCode}"
                    IsChecked="{Binding Path=WorkWithFacadeType}"/>
                
                <ui:TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="5"
                    TextWrapping="Wrap"
                    Text="Параметр дял типа фасада" />
                
                <ComboBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="5"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" 
                    IsEnabled="{Binding Path=WorkWithFacadeCode}"
                    DisplayMemberPath="Definition.Name"
                    SelectedItem="{Binding Path=ParamForFacadeType, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding Path=ParamsForFacadeType, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right">

            <ui:TextBlock
                Margin="10"
                Foreground="Orange"
                VerticalAlignment="Center"
                Text="{Binding ErrorText}" />

            <ui:Button
                Margin="10"
                Width="80"
                Appearance="Info"
                Content="{me:LocalizationSource MainWindow.ButtonOk}"
                Click="ButtonOk_Click"
                Command="{Binding AcceptViewCommand}" />

            <ui:Button
                Margin="10"
                Width="80"
                Content="{me:LocalizationSource MainWindow.ButtonCancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>
