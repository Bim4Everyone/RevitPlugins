<core:WpfUIPlatformPage
    x:Class="RevitOpeningPlacement.Views.Settings.Kr.KrNavigatorSettingsPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:RevitOpeningPlacement.ViewModels.OpeningConfig"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:controls="clr-namespace:RevitOpeningPlacement.Views.Settings.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:KrNavigatorSettingsViewModel, IsDesignTimeCreatable=False}">
    <core:WpfUIPlatformPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../../Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformPage.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto">
        <StackPanel
            Margin="8 0 8 8">
            <Label
                Margin="0 8 0 4"
                Style="{StaticResource SectionHeaderLabel}"
                Content="{me:LocalizationSource NavigatorSettings.Section.IncomingTasks}" />
            <controls:IncomingStatusesControl
                DataContext="{Binding IncomingStatuses}" />

            <Label
                Margin="0 24 0 4"
                Style="{StaticResource SectionHeaderLabel}"
                Content="{me:LocalizationSource NavigatorSettings.Section.RealOpenings}" />
            <controls:RealOpeningStatusesControl
                DataContext="{Binding RealOpeningStatuses}" />

            <controls:StatusToggleControl
                DataContext="{Binding RealOpeningStatuses}"
                Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                Title="{me:LocalizationSource NavigatorSettings.Real.TooClose.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Real.TooClose.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                IsChecked="{Binding CheckTooClose, UpdateSourceTrigger=PropertyChanged}">
                <controls:StatusValueControl
                    IsNested="True"
                    Icon="{ui:SymbolIcon Ruler24}"
                    Title="{me:LocalizationSource NavigatorSettings.Real.TooClose.DistanceTitle}"
                    Description="{me:LocalizationSource NavigatorSettings.Real.TooClose.DistanceValue}">
                    <ui:TextBox
                        MinWidth="{StaticResource SmallInputWidth}"
                        Width="{StaticResource SmallInputWidth}"
                        IsEnabled="{Binding CheckTooClose}"
                        Text="{Binding MinDistance, UpdateSourceTrigger=PropertyChanged}" />
                </controls:StatusValueControl>
            </controls:StatusToggleControl>
        </StackPanel>
    </ScrollViewer>
</core:WpfUIPlatformPage>
