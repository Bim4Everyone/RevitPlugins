<core:WpfUIPlatformUserControl
    x:Class="RevitOpeningPlacement.Views.Settings.Controls.IncomingStatusesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:RevitOpeningPlacement.ViewModels.OpeningConfig"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:controls="clr-namespace:RevitOpeningPlacement.Views.Settings.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:IncomingStatusesViewModel, IsDesignTimeCreatable=False}">
    <core:WpfUIPlatformUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../../Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformUserControl.Resources>
    <StackPanel>
        <controls:StatusToggleControl
            Title="{me:LocalizationSource NavigatorSettings.Incoming.UnacceptableConstructions.Title}"
            Description="{me:LocalizationSource NavigatorSettings.Incoming.UnacceptableConstructions.Description}"
            CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
            IsChecked="{Binding CheckUnacceptableConstructions, UpdateSourceTrigger=PropertyChanged}" />

        <controls:StatusToggleControl
            Title="{me:LocalizationSource NavigatorSettings.Incoming.Intersections.Title}"
            Description="{me:LocalizationSource NavigatorSettings.Incoming.Intersections.Description}"
            CostTag="{me:LocalizationSource NavigatorSettings.Cost.Slow}"
            IsChecked="{Binding CheckIntersections, UpdateSourceTrigger=PropertyChanged}">
            <controls:StatusToggleControl.NestedContent>
                <StackPanel>
                    <controls:StatusToggleControl
                        Title="{me:LocalizationSource NavigatorSettings.Incoming.DifferentConstructions.Title}"
                        Description="{me:LocalizationSource NavigatorSettings.Incoming.DifferentConstructions.Description}"
                        CostTag="{me:LocalizationSource NavigatorSettings.Cost.Fast}"
                        IsChecked="{Binding CheckDifferentConstructions, UpdateSourceTrigger=PropertyChanged}" />

                    <controls:StatusToggleControl
                        Title="{me:LocalizationSource NavigatorSettings.Incoming.Host.Title}"
                        Description="{me:LocalizationSource NavigatorSettings.Incoming.Host.Description}"
                        CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                        IsChecked="{Binding CheckHost, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </controls:StatusToggleControl.NestedContent>
        </controls:StatusToggleControl>
    </StackPanel>
</core:WpfUIPlatformUserControl>
