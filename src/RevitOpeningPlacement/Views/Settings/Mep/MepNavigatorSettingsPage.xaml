<core:WpfUIPlatformPage
    x:Class="RevitOpeningPlacement.Views.Settings.Mep.MepNavigatorSettingsPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:RevitOpeningPlacement.ViewModels.OpeningConfig"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:controls="clr-namespace:RevitOpeningPlacement.Views.Settings.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:MepNavigatorSettingsViewModel, IsDesignTimeCreatable=False}">
    <core:WpfUIPlatformPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../../Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformPage.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="0 0 0 8">
            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.ManuallyPlaced.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.ManuallyPlaced.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Fast}"
                IsChecked="{Binding CheckManuallyPlaced, UpdateSourceTrigger=PropertyChanged}" />

            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.NotActual.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.NotActual.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Slow}"
                IsChecked="{Binding CheckNotActual, UpdateSourceTrigger=PropertyChanged}">
                <controls:StatusToggleControl.NestedContent>
                    <StackPanel>
                        <StackPanel
                            Orientation="Horizontal">
                            <ui:ToggleSwitch
                                Content="{me:LocalizationSource NavigatorSettings.Outcoming.DifferentConstructions.Title}"
                                IsChecked="{Binding CheckDifferentConstructions, UpdateSourceTrigger=PropertyChanged}" />
                            <Border
                                Style="{StaticResource StatusToggleTagBorder}">
                                <ui:TextBlock
                                    Style="{StaticResource StatusToggleTagText}"
                                    Text="{me:LocalizationSource NavigatorSettings.Cost.Fast}" />
                            </Border>
                        </StackPanel>
                        <ui:TextBlock
                            Margin="0 4 0 0"
                            TextWrapping="Wrap"
                            TextAlignment="Justify"
                            Text="{me:LocalizationSource NavigatorSettings.Outcoming.DifferentConstructions.Description}" />
                    </StackPanel>
                </controls:StatusToggleControl.NestedContent>
            </controls:StatusToggleControl>

            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.Host.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.Host.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                IsChecked="{Binding CheckHost, UpdateSourceTrigger=PropertyChanged}" />

            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.UnacceptableConstructions.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.UnacceptableConstructions.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                IsChecked="{Binding CheckUnacceptableConstructions, UpdateSourceTrigger=PropertyChanged}" />

            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.Intersects.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.Intersects.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                IsChecked="{Binding CheckIntersects, UpdateSourceTrigger=PropertyChanged}" />

            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.United.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.United.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                IsChecked="{Binding CheckUnited, UpdateSourceTrigger=PropertyChanged}" />

            <controls:StatusToggleControl
                Title="{me:LocalizationSource NavigatorSettings.Outcoming.Offsets.Title}"
                Description="{me:LocalizationSource NavigatorSettings.Outcoming.Offsets.Description}"
                CostTag="{me:LocalizationSource NavigatorSettings.Cost.Medium}"
                IsChecked="{Binding CheckOffsets, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </ScrollViewer>
</core:WpfUIPlatformPage>
