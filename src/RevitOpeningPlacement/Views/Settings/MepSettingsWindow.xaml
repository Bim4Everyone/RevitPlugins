<core:WpfUIPlatformWindow
    x:Class="RevitOpeningPlacement.Views.Settings.MepSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vms="clr-namespace:RevitOpeningPlacement.ViewModels.OpeningConfig"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:pagesMep="clr-namespace:RevitOpeningPlacement.Views.Settings.Mep"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:wpfbehaviors="clr-namespace:dosymep.WpfCore.Behaviors;assembly=dosymep.WpfCore"
    mc:Ignorable="d"
    WindowStartupLocation="CenterOwner"
    Height="760"
    Width="1250"
    MinHeight="500"
    MinWidth="900"
    d:DataContext="{d:DesignInstance vms:MepSettingsViewModel, IsDesignTimeCreatable=False}">
    <core:WpfUIPlatformWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../Resources/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformWindow.Resources>
    <i:Interaction.Behaviors>
        <wpfbehaviors:WpfAttachServiceBehavior
            AttachableService="{Binding MessageBoxService}" />
        <wpfbehaviors:WpfAttachServiceBehavior
            AttachableService="{Binding OpenFileDialogService}" />
        <wpfbehaviors:WpfAttachServiceBehavior
            AttachableService="{Binding SaveFileDialogService}" />
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            x:Name="_titleBar"
            Title="{me:LocalizationSource MepSettingsWindow.Title}" />

        <ui:NavigationView
            Grid.Row="1"
            x:Name="_rootNavigationView"
            FrameMargin="0"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            IsPaneOpen="True"
            IsPaneToggleVisible="True"
            IsBackButtonVisible="Collapsed"
            TitleBar="{Binding ElementName=_titleBar}"
            BreadcrumbBar="{Binding ElementName=_breadcrumbBar}">

            <ui:NavigationView.Header>
                <StackPanel
                    Margin="8 8  0 8">
                    <ui:BreadcrumbBar
                        x:Name="_breadcrumbBar">
                        <ui:BreadcrumbBar.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock
                                    FontTypography="Subtitle"
                                    Text="{Binding Content}" />
                            </DataTemplate>
                        </ui:BreadcrumbBar.ItemTemplate>
                    </ui:BreadcrumbBar>
                </StackPanel>
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Icon="{ui:SymbolIcon Symbol=TableSettings24}"
                    Content="{me:LocalizationSource SettingsNavigation.PlacementSettings}"
                    TargetPageType="{x:Type pagesMep:MepPlacementSettingsPage}" />
                <ui:NavigationViewItem
                    Icon="{ui:SymbolIcon Symbol=DocumentTableCheckmark24}"
                    Content="{me:LocalizationSource SettingsNavigation.NavigatorSettings}"
                    TargetPageType="{x:Type pagesMep:MepNavigatorSettingsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <ui:TextBlock
                Margin="8"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Text="{Binding ErrorText}"
                Style="{StaticResource CustomErrorText}" />
            <ui:Button
                Width="80"
                Margin="8"
                IsDefault="True"
                Click="ButtonOk_Click"
                Appearance="Info"
                Content="{me:LocalizationSource Ok}"
                Command="{Binding SaveConfigCommand}" />
            <ui:Button
                Width="80"
                Margin="8"
                IsCancel="true"
                Click="ButtonCancel_Click"
                Content="{me:LocalizationSource Cancel}" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>