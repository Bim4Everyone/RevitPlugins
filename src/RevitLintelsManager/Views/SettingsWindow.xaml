<core:WpfUIPlatformWindow
    x:Class="RevitLintelsManager.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:pages="clr-namespace:RevitLintelsManager.Views.Pages"
    xmlns:vms="clr-namespace:RevitLintelsManager.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    mc:Ignorable="d"
    Title="{me:LocalizationSource MainWindow.Title}"
    Height="850"
    Width="1450"
    MinHeight="850"
    MinWidth="1450"
    d:DataContext="{d:DesignInstance vms:SettingsViewModel, IsDesignTimeCreatable=False}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadViewCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Grid.Row="0"
            Icon="{ui:SymbolIcon Settings24, FontSize=20}"
            Title="{me:LocalizationSource MainWindow.Title}"
            FontSize="14"
            FontWeight="DemiBold" />
        <ui:NavigationView
            x:Name="_rootNavigationView"
            Grid.Row="1"
            FrameMargin="0"
            OpenPaneLength="300"
            IsPaneOpen="True"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneVisible="True"
            IsPaneToggleVisible="True"
            PaneTitle="{me:LocalizationSource MainWindow.Settings}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Height="50"
                    FontSize="20"
                    HorizontalAlignment="Stretch"
                    Content="{me:LocalizationSource MainWindow.FamilySettings}"
                    TargetPageType="{x:Type pages:FamilySettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="25"/>
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            Style="{StaticResource RoundInfoBadgeStyle}"
                            Visibility="{Binding HasFamilySettingsErrors, 
                            Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Height="50"
                    FontSize="20"
                    HorizontalAlignment="Stretch"
                    Content="{me:LocalizationSource MainWindow.PlacementSettings}"
                    TargetPageType="{x:Type pages:PlacementSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="slideSettings24" FontSize="25"/>
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            Style="{StaticResource RoundInfoBadgeStyle}"
                            Visibility="{Binding HasPlacementSettingsErrors, 
                            Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Height="50"
                    FontSize="20"
                    HorizontalAlignment="Stretch"
                    Content="{me:LocalizationSource MainWindow.GeneralSettings}"
                    TargetPageType="{x:Type pages:GeneralSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Options24" FontSize="25"/>
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge
                            Style="{StaticResource RoundInfoBadgeStyle}"
                            Visibility="{Binding HasGeneralSettingsErrors, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
        <StackPanel
            Grid.Row="2"
            Margin="12,8"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <ui:TextBlock
                Margin="8"
                Foreground="Orange"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Text="{Binding ErrorText}" />
            <ui:Button
                Margin="8,0"
                MinWidth="110"
                Appearance="Info"
                IsDefault="True"
                Content="{me:LocalizationSource MainWindow.ButtonOk}"
                Command="{Binding AcceptViewCommand}" />
            <ui:Button
                Margin="8,0"
                MinWidth="110"
                Content="{me:LocalizationSource MainWindow.ButtonCancel}"
                IsCancel="True"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</core:WpfUIPlatformWindow>
