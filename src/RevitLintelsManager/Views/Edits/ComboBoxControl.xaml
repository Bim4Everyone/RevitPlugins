<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style TargetType="edits:ComboBoxControl">
        <Setter Property="Margin" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="edits:ComboBoxControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="{Binding WidthTextBlock, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{TemplateBinding TextTextBlock}"
                            TextWrapping="WrapWithOverflow" />
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{TemplateBinding ItemsSource}"
                            SelectedValue="{Binding SelectedValue,
                                RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            ToolTip="{Binding SelectedValue.Name, RelativeSource={RelativeSource TemplatedParent}}"
                            DisplayMemberPath="Name" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
