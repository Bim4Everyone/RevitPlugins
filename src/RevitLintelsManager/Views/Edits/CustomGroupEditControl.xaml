<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style
        TargetType="edits:CustomGroupEditControl">
        <Setter Property="Margin" Value="10,10,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="edits:CustomGroupEditControl">
                    <ui:CardExpander
                        x:Name="PART_Expander"
                        IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        HorizontalContentAlignment="Stretch"
                        ContentPadding="{TemplateBinding ContentPadding}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Icon="{TemplateBinding Icon}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    TextWrapping="WrapWithOverflow"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{TemplateBinding Header}">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding HeaderContent,
                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                    Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    Content="{TemplateBinding HeaderContent}" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ContentControl
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding EditControl}" />
                    </ui:CardExpander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
