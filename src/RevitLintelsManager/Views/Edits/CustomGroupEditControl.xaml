<UserControl
    x:Class="RevitLintelsManager.Views.Edits.CustomGroupEditControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    x:Name="_this"
    Margin="10,10,10,0"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="300">
    <ui:CardExpander
        IsExpanded="{Binding IsExpanded, ElementName=_this, Mode=TwoWay}"
        HorizontalContentAlignment="Stretch"
        ContentPadding="{Binding ContentPadding, ElementName=_this}"
        Loaded="OnCardExpanderLoaded"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Icon="{Binding Icon, ElementName=_this}">
        <ui:CardExpander.Header>
            <Grid>
                <ui:TextBlock
                    Grid.Column="0"
                    FontTypography="BodyStrong"
                    TextWrapping="WrapWithOverflow"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Header, ElementName=_this}">
                    <ui:TextBlock.Style>
                        <Style
                            TargetType="ui:TextBlock">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding HeaderContent, ElementName=_this}"
                                    Value="{x:Null}">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:TextBlock.Style>
                </ui:TextBlock>
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{Binding HeaderContent, ElementName=_this}" />
            </Grid>
        </ui:CardExpander.Header>
        <ContentControl
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Content="{Binding EditControl, ElementName=_this}" />
    </ui:CardExpander>
</UserControl>
