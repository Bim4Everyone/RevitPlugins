<core:WpfUIPlatformPage 
    x:Class="RevitLintelsManager.Views.Pages.FamilySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    xmlns:vms="clr-namespace:RevitLintelsManager.ViewModels"
    d:DataContext="{d:DesignInstance vms:FamilySettingsViewModel, IsDesignTimeCreatable=False}"
    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d" x:ClassModifier="internal">
    
    <core:WpfUIPlatformPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformPage.Resources>
    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="*" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding Content.IsExpanded, ElementName=_openingFamiliesSection}"
                                Value="False">
                                <Setter Property="Height" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <edits:CustomGroupEditControl
            VerticalAlignment="Stretch"
            Icon="{ui:SymbolIcon scanText24}"
            Header="{me:LocalizationSource FamilySettingsPage.LintelFamilies}">
                
            <edits:CustomGroupEditControl.EditControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <ui:AutoSuggestBox
                            Icon="{ui:SymbolIcon Search24}"
                            DockPanel.Dock="Top"
                            Margin="10,0,10,8"
                            PlaceholderText="{me:LocalizationSource Search.Family}"
                            Text="{Binding LintelSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding SearchLintelFamiliesCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ui:AutoSuggestBox>

                        
                        <ListBox
                            Style="{StaticResource SettingsListStyle}"
                            MaxHeight="330"
                            ItemsSource="{Binding FilteredLintelFamilies}"
                            Loaded="OnLintelFamiliesLoaded"
                            SelectionMode="Single"
                            Background="Transparent"
                            BorderThickness="0">

                            <!-- Убираем фон и выделение всей строки -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="10,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                                    <!-- Собственный шаблон без визуализации IsSelected -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vms:FamilyViewModel}">
                                    <RadioButton
                                        Content="{Binding Name}"
                                        GroupName="LintelFamilies"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        Command="{Binding DataContext.SelectLintelFamilyCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Column="1">
                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelWidthParamLabel}"
                            ItemsSource="{Binding LintelParametersDouble}"
                            SelectedValue="{Binding SelectedLintelWidthParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelThicknessParamLabel}"
                            ItemsSource="{Binding LintelParametersDouble}"
                            SelectedValue="{Binding SelectedLintelThicknessParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelRightOffsetParamLabel}"
                            ItemsSource="{Binding LintelParametersDouble}"
                            SelectedValue="{Binding SelectedLintelRightOffsetParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelLeftOffsetParamLabel}"
                            ItemsSource="{Binding LintelParametersDouble}"
                            SelectedValue="{Binding SelectedLintelLeftOffsetParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelRightCornerParamLabel}"
                            ItemsSource="{Binding LintelParametersInteger}"
                            SelectedValue="{Binding SelectedLintelRightCornerParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelLeftCornerParamLabel}"
                            ItemsSource="{Binding LintelParametersInteger}"
                            SelectedValue="{Binding SelectedLintelLeftCornerParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelRightWeldingParamLabel}"
                            ItemsSource="{Binding LintelParametersInteger}"
                            SelectedValue="{Binding SelectedLintelRightWeldingParam}"/>

                        <edits:ComboBoxControl
                            WidthTextBlock="250"
                            TextTextBlock="{me:LocalizationSource FamilySettingsPage.LintelLeftWeldingParamLabel}"
                            ItemsSource="{Binding LintelParametersInteger}"
                            SelectedValue="{Binding SelectedLintelLeftWeldingParam}"/>
                    </StackPanel>
                </Grid>

            </edits:CustomGroupEditControl.EditControl>
        </edits:CustomGroupEditControl>

        <ContentPresenter
            x:Name="_openingFamiliesSection"
            Grid.Row="1">
            <ContentPresenter.Content>
                <edits:CustomGroupEditControl
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon scanText24}"
                    Header="{me:LocalizationSource FamilySettingsPage.OpeningFamilies}">

                    <edits:CustomGroupEditControl.EditControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DockPanel
                                Grid.Column="0"
                                Margin="0,0,12,0">

                                <ui:AutoSuggestBox
                                    Icon="{ui:SymbolIcon Search24}"
                                    DockPanel.Dock="Top"
                                    Margin="10,0,10,8"
                                    PlaceholderText="{me:LocalizationSource Search.Family}"
                                    Text="{Binding OpeningSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="TextChanged">
                                            <i:InvokeCommandAction Command="{Binding SearchOpeningFamiliesCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ui:AutoSuggestBox>

                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Style="{StaticResource SettingsListStyle}"
                                    ItemContainerStyle="{StaticResource SettingsCheckListItemStyle}"
                                    ItemsSource="{Binding FilteredOpeningFamilies}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate
                                            DataType="{x:Type vms:FamilyViewModel}">
                                            <edits:ItemControl
                                                ItemName="{Binding Name}"
                                                IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <ScrollViewer
                                Grid.Column="1"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <edits:ComboBoxControl
                                    WidthTextBlock="250"
                                    TextTextBlock="{me:LocalizationSource FamilySettingsPage.OpeningHeightParamLabel}"
                                    ItemsSource="{Binding OpeningParameters}"
                                    SelectedValue="{Binding SelectedOpeningHeightParam}"/>

                                <edits:ComboBoxControl
                                    WidthTextBlock="250"
                                    TextTextBlock="{me:LocalizationSource FamilySettingsPage.OpeningWidthParamLabel}"
                                    ItemsSource="{Binding OpeningParameters}"
                                    SelectedValue="{Binding SelectedOpeningWidthParam}"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </edits:CustomGroupEditControl.EditControl>
                </edits:CustomGroupEditControl>
            </ContentPresenter.Content>
        </ContentPresenter>
    </Grid>
</core:WpfUIPlatformPage>
