<core:WpfUIPlatformPage
    x:Class="RevitLintelsManager.Views.Pages.PlacementSettingsPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}">
    <core:WpfUIPlatformPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformPage.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:Card Padding="16">
            <WrapPanel VerticalAlignment="Center">
                <ui:TextBlock
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Text="{me:LocalizationSource Config.Current}" />
                <ComboBox
                    Width="230"
                    Margin="0,0,16,0"
                    ItemsSource="{Binding Configs}"
                    SelectedItem="{Binding SelectedConfig}"
                    DisplayMemberPath="Name" />
                <ui:Button
                    Margin="3,0"
                    ToolTip="{me:LocalizationSource Config.Create}"
                    Command="{Binding CreateConfigCommand}">
                    <ui:SymbolIcon Symbol="DocumentAdd24" />
                </ui:Button>
                <ui:Button
                    Margin="3,0"
                    ToolTip="{me:LocalizationSource Config.Import}"
                    Command="{Binding ImportConfigCommand}">
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:Button>
                <ui:Button
                    Margin="3,0"
                    ToolTip="{me:LocalizationSource Config.Save}"
                    Command="{Binding SaveConfigCommand}">
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:Button>
                <ui:Button
                    Margin="3,0"
                    ToolTip="{me:LocalizationSource Config.SaveAs}"
                    Command="{Binding SaveAsConfigCommand}">
                    <ui:SymbolIcon Symbol="ArrowUpload24" />
                </ui:Button>
                <ui:Button
                    Margin="3,0"
                    ToolTip="{me:LocalizationSource Config.Delete}"
                    Command="{Binding DeleteConfigCommand}">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>
                <ui:Button
                    Margin="3,0"
                    ToolTip="{me:LocalizationSource Config.Copy}"
                    Command="{Binding CopyConfigCommand}">
                    <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button>
            </WrapPanel>
        </ui:Card>
        <ui:TextBlock
            Grid.Row="1"
            Margin="8,12"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Text="{me:LocalizationSource Config.ReadOnlyNote}"
            Visibility="{Binding SelectedConfig.IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <!-- В шаблонах используем DynamicResource: LocalizationSource выдаёт недопустимое выражение при их создании. -->
        <TabControl
            Grid.Row="2"
            Margin="0,12,0,0"
            ItemContainerStyle="{StaticResource SettingsRuleTabItemStyle}"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{Binding SelectedConfig.PlaceRules}"
            SelectedItem="{Binding SelectedConfig.SelectedRule}">
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel
                                Orientation="Horizontal"
                                IsItemsHost="True"
                                KeyboardNavigation.TabIndex="1" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                Padding="12,4"
                                VerticalAlignment="Stretch"
                                FontSize="20"
                                ToolTip="{DynamicResource Rule.Create}"
                                AutomationProperties.Name="{DynamicResource Rule.Create}"
                                Command="{Binding DataContext.AddPlaceRuleCommand, 
                                RelativeSource={RelativeSource TemplatedParent}}" >
                                <ui:SymbolIcon Symbol="add24" />
                            </ui:Button>
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                ContentSource="SelectedContent"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Name}" />
                        <Viewbox
                            Width="24"
                            Height="24"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <ui:SymbolIcon
                                Foreground="Orange"
                                Symbol="Warning24"
                                ToolTip="{Binding ErrorText}"
                                AutomationProperties.Name="{Binding ErrorText}" />

                        </Viewbox>
                        <ui:Button
                            Margin="5,2,5,2"
                            Padding="5"
                            ToolTip="{DynamicResource Rule.Rename}"
                            Command="{Binding DataContext.RenamePlaceRuleCommand, 
                            RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                            CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Edit16" />
                        </ui:Button>
                        <ui:Button
                            Margin="5,2,5,2"
                            Padding="5"
                            ToolTip="{DynamicResource Rule.Delete}"
                            Command="{Binding DataContext.DeletePlaceRuleCommand,
                            RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                            CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Dismiss16" />
                        </ui:Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="230" />
                            <ColumnDefinition Width="3*" MinWidth="490" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Margin="0,0,12,12"
                            VerticalAlignment="Center"
                            Text="{DynamicResource Rule.WallTypes}" />
                        
                        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <ui:AutoSuggestBox
                                Icon="{ui:SymbolIcon Search24}"
                                DockPanel.Dock="Top"
                                Margin="0,0,0,12"
                                PlaceholderText="{DynamicResource Search.WallType}"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged">
                                        <i:InvokeCommandAction Command="{Binding SearchWallsCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ui:AutoSuggestBox>
                            <ListBox
                                Style="{StaticResource SettingsListStyle}"
                                ItemContainerStyle="{StaticResource SettingsCheckListItemStyle}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding FilteredWalls}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="3"
                                            Content="{Binding Name}"
                                            ToolTip="{Binding Name}"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,0,12">
                            <ui:Button
                                DockPanel.Dock="Right"
                                Padding="8,4"
                                ToolTip="{DynamicResource Rule.AddRange}"
                                Command="{Binding DataContext.AddRuleCommand, 
                                RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}">
                                <ui:SymbolIcon Symbol="Add20" />
                            </ui:Button>
                            <ui:TextBlock
                                VerticalAlignment="Center"
                                Text="{DynamicResource Rule.Ranges}" />
                        </DockPanel>
                        <DataGrid
                            Grid.Row="1"
                            Grid.Column="1"
                            MaxHeight="400"
                            VerticalAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            HeadersVisibility="Column"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="False"
                            CanUserReorderColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Rules}"
                            RowHeight="50"
                            ColumnHeaderHeight="40">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="140">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource Rule.OpeningWidth}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Padding="4"
                                                    VerticalContentAlignment="Center"
                                                    IsReadOnly="{Binding DataContext.IsReadOnly, 
                                                    RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                                                    Text="{Binding MinWidthText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Text="–" />
                                                <TextBox
                                                    Grid.Column="2"
                                                    Padding="4"
                                                    VerticalContentAlignment="Center"
                                                    IsReadOnly="{Binding DataContext.IsReadOnly, 
                                                    RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                                                    Text="{Binding MaxWidthText, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="110">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource Rule.Support}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Margin="3"
                                                Padding="4"
                                                VerticalContentAlignment="Center"
                                                IsReadOnly="{Binding DataContext.IsReadOnly, 
                                                RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                                                Text="{Binding WallSupportText, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="*"
                                    MinWidth="150">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource Rule.LintelType}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox
                                                Margin="3"
                                                IsEditable="True"
                                                IsReadOnly="True"
                                                IsEnabled="{Binding DataContext.CanEditRules, 
                                                RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                                                ItemsSource="{Binding DataContext.LintelTypes, 
                                                RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                                                ToolTip="{Binding LintelType}"
                                                Text="{Binding LintelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                                <ui:SymbolIcon
                                                    Margin="3"
                                                    Foreground="Orange"
                                                    Symbol="Warning20"
                                                    ToolTip="{Binding ErrorText}"
                                                    AutomationProperties.Name="{Binding ErrorText}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Visibility="{Binding HasErrors, 
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ui:Button
                                                    Padding="3"
                                                    ToolTip="{DynamicResource Rule.DeleteRange}"
                                                    Command="{Binding DataContext.DeleteRuleCommand, 
                                                    RelativeSource={RelativeSource AncestorType=core:WpfUIPlatformPage}}"
                                                    CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss16" />
                                                </ui:Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <ui:TextBlock
            Grid.Row="3"
            Margin="8"
            TextWrapping="Wrap"
            Text="{Binding StatusText}" />
    </Grid>
</core:WpfUIPlatformPage>
