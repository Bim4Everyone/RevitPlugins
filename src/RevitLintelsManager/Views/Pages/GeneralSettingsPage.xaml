<core:WpfUIPlatformPage
    x:Class="RevitLintelsManager.Views.Pages.GeneralSettingsPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}">
    <core:WpfUIPlatformPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </core:WpfUIPlatformPage.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ui:Card Margin="10" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock
                        Margin="0,8,20,8"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Text="{me:LocalizationSource General.FixParameter}" />
                    <ComboBox
                        Grid.Column="1"
                        Margin="0,5"
                        ItemsSource="{Binding FixParameters}"
                        SelectedItem="{Binding SelectedFixParameter}"
                        DisplayMemberPath="Name" />
                    <ui:TextBlock
                        Grid.Row="1"
                        Margin="0,8,20,8"
                        VerticalAlignment="Center"
                        Text="{me:LocalizationSource General.Phase}" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5"
                        ItemsSource="{Binding Phases}"
                        SelectedItem="{Binding SelectedPhase}"
                        DisplayMemberPath="Name" />
                    <ui:TextBlock
                        Grid.Row="2"
                        Margin="0,8,20,8"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Text="{me:LocalizationSource General.MinimalHeight}" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,5"
                        PlaceholderText="{me:LocalizationSource General.Millimeters}"
                        Text="{Binding MinimalHeightText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </ui:Card>
            <edits:CustomGroupEditControl
                Header="{me:LocalizationSource General.StructureWalls}"
                Icon="{ui:SymbolIcon Building24}">
                <edits:CustomGroupEditControl.EditControl>
                    <DockPanel Margin="8">
                        <ui:AutoSuggestBox
                            Icon="{ui:SymbolIcon Search24}"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,12"
                            PlaceholderText="{me:LocalizationSource Search.WallType}"
                            Text="{Binding WallSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TextChanged">
                                    <i:InvokeCommandAction Command="{Binding SearchStructureWallsCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ui:AutoSuggestBox>
                        <ListBox
                            Style="{StaticResource SettingsListStyle}"
                            ItemContainerStyle="{StaticResource SettingsCheckListItemStyle}"
                            MaxHeight="300"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredStructureWalls}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="4"
                                        Content="{Binding Name}"
                                        ToolTip="{Binding Name}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </edits:CustomGroupEditControl.EditControl>
            </edits:CustomGroupEditControl>
        </StackPanel>
    </ScrollViewer>
</core:WpfUIPlatformPage>
