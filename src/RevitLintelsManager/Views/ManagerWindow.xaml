<core:WpfUIPlatformWindow
    x:Class="RevitLintelsManager.Views.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    Title="{me:LocalizationSource Manager.Title}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Width="1430"
    Height="845"
    MinWidth="1000"
    MinHeight="450">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="Styles.xaml" />
                <ResourceDictionary
                    Source="ManagerRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource Manager.Title}" />
        <WrapPanel
            Grid.Row="1"
            Margin="20,16,20,0"
            HorizontalAlignment="Right">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="{me:LocalizationSource Manager.Range}" />
            <edits:ModeSwitcherControl
                Margin="0,0,8,0"
                IsEnabled="{Binding CanChangeScope}"
                ItemsSource="{Binding Scopes}"
                SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                ItemInvokedCommand="{Binding SelectScopeCommand}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{Binding ContextSummary}" />
            <ui:Button
                Width="33"
                Height="33"
                MinWidth="0"
                Padding="0"
                CornerRadius="4"
                VerticalAlignment="Center"
                Appearance="Primary"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                Command="{Binding RefreshCommand}"
                ToolTip="{me:LocalizationSource Manager.Refresh}"
                AutomationProperties.Name="{me:LocalizationSource Manager.Refresh}">
                <ui:SymbolIcon
                    Symbol="ArrowSync24"
                    FontSize="20" />
            </ui:Button>
        </WrapPanel>
        <Border
            Grid.Row="2"
            Margin="20"
            CornerRadius="8">
            <Border.Style>
                <Style
                    TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsBlocked}"
                            Value="True">
                            <Setter
                                Property="IsEnabled"
                                Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ListBox
                x:Name="RowsList"
                ScrollViewer.ScrollChanged="OnRowsScrollChanged"
                IsEnabled="{Binding CanEditRows}"
                BorderThickness="0"
                Background="Transparent"
                Style="{StaticResource SettingsListStyle}"
                ItemsSource="{Binding VisibleRows}"
                ItemContainerStyle="{StaticResource ManagerChildItemStyle}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>
        <Grid
            Grid.Row="3"
            Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ManagerWarningBrush}"
                TextWrapping="Wrap"
                Text="{Binding GeneralMessage}"
                Visibility="{Binding HasGeneralMessage, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Grid.Column="1"
                MinWidth="130"
                Margin="0,0,16,0"
                Appearance="Primary"
                IsEnabled="False"
                Content="{Binding ProcessText}"
                ToolTip="{me:LocalizationSource Manager.NotImplemented}"
                ToolTipService.ShowOnDisabled="True" />
            <ui:Button
                Grid.Column="2"
                MinWidth="130"
                Content="{me:LocalizationSource Manager.Close}"
                Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</core:WpfUIPlatformWindow>
