<core:WpfUIPlatformWindow
    x:Class="RevitLintelsManager.Views.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:dosymep.WpfUI.Core"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:vm="clr-namespace:RevitLintelsManager.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    Title="{me:LocalizationSource Manager.Title}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Width="1430"
    Height="845"
    MinWidth="1000"
    MinHeight="450">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="Styles.xaml" />
                <ResourceDictionary
                    Source="ManagerRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Grid.Row="0"
            Title="{me:LocalizationSource Manager.Title}" />
        <UniformGrid
            Grid.Row="1"
            Columns="3"
            Margin="20,12,8,0"
            IsEnabled="{Binding CanEditRows}">
            <RadioButton
                GroupName="ManagerResultFilter"
                Style="{StaticResource ManagerFilterButtonStyle}"
                BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillChecked}"
                IsChecked="{Binding IsAllResultsFilter, Mode=OneWay}"
                Command="{Binding SelectResultFilterCommand}"
                CommandParameter="{x:Static vm:ManagerResultFilter.All}">
                <DockPanel>
                    <ui:SymbolIcon
                        Symbol="Info24"
                        FontSize="24"
                        Margin="0,0,10,0" />
                    <TextBlock
                        Style="{StaticResource ManagerFilterLabelStyle}"
                        Text="{Binding AllResultsText}" />
                </DockPanel>
            </RadioButton>
            <RadioButton
                GroupName="ManagerResultFilter"
                Style="{StaticResource ManagerFilterButtonStyle}"
                BorderBrush="{DynamicResource ManagerWarningBrush}"
                IsChecked="{Binding IsWarningResultsFilter, Mode=OneWay}"
                Command="{Binding SelectResultFilterCommand}"
                CommandParameter="{x:Static vm:ManagerResultFilter.Warning}">
                <DockPanel>
                    <ui:SymbolIcon
                        Symbol="ErrorCircle24"
                        FontSize="24"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource ManagerWarningBrush}" />
                    <TextBlock
                        Style="{StaticResource ManagerFilterLabelStyle}"
                        Text="{Binding WarningResultsText}" />
                </DockPanel>
            </RadioButton>
            <RadioButton
                GroupName="ManagerResultFilter"
                Style="{StaticResource ManagerFilterButtonStyle}"
                BorderBrush="{DynamicResource ManagerSuccessBrush}"
                IsChecked="{Binding IsCorrectResultsFilter, Mode=OneWay}"
                Command="{Binding SelectResultFilterCommand}"
                CommandParameter="{x:Static vm:ManagerResultFilter.Correct}">
                <DockPanel>
                    <ui:SymbolIcon
                        Symbol="CheckmarkCircle24"
                        FontSize="24"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource ManagerSuccessBrush}" />
                    <TextBlock
                        Style="{StaticResource ManagerFilterLabelStyle}"
                        Text="{Binding CorrectResultsText}" />
                </DockPanel>
            </RadioButton>
        </UniformGrid>
        <DockPanel
            Grid.Row="2"
            Margin="20,12,20,0"
            IsEnabled="{Binding CanEditRows}">
            <ui:Button
                DockPanel.Dock="Right"
                Width="33"
                Height="33"
                MinWidth="0"
                Padding="0"
                CornerRadius="4"
                VerticalAlignment="Center"
                Appearance="Primary"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                Command="{Binding RefreshCommand}"
                ToolTip="{me:LocalizationSource Manager.Refresh}"
                AutomationProperties.Name="{me:LocalizationSource Manager.Refresh}">
                <ui:SymbolIcon
                    Symbol="ArrowSync24"
                    FontSize="20" />
            </ui:Button>
            <edits:ModeSwitcherControl
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                IsEnabled="{Binding CanChangeScope}"
                ItemsSource="{Binding Scopes}"
                SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                ItemInvokedCommand="{Binding SelectScopeCommand}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{Binding ContextSummary}" />
            <ui:AutoSuggestBox
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{me:LocalizationSource Manager.Search}"
                AutomationProperties.Name="{me:LocalizationSource Manager.Search}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <Border
            Grid.Row="3"
            Margin="20"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Style>
                <Style
                    TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsBlocked}"
                            Value="True">
                            <Setter
                                Property="IsEnabled"
                                Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Grid
                    DockPanel.Dock="Top"
                    Margin="27,4,58,0"
                    MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="144" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Width="24"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsThreeState="True"
                        IsChecked="{Binding AreAllRowsChecked, Mode=OneWay}"
                        Command="{Binding ToggleAllRowsCommand}"
                        ToolTip="{me:LocalizationSource Manager.ToggleAllRows}"
                        AutomationProperties.Name="{me:LocalizationSource Manager.ToggleAllRows}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource ManagerColumnHeaderStyle}"
                        Text="{me:LocalizationSource Manager.OpeningColumn}" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource ManagerColumnHeaderStyle}"
                        Text="{me:LocalizationSource Manager.LintelColumn}" />
                    <TextBlock
                        Grid.Column="4"
                        Style="{StaticResource ManagerColumnHeaderStyle}"
                        Text="{me:LocalizationSource Manager.ActionsColumn}" />
                    <TextBlock
                        Grid.Column="5"
                        Margin="12,0,0,0"
                        Style="{StaticResource ManagerColumnHeaderStyle}"
                        Text="{me:LocalizationSource Manager.QuantityColumn}" />
                </Grid>
                <ListBox
                    x:Name="RowsList"
                    ScrollViewer.ScrollChanged="OnRowsScrollChanged"
                    IsEnabled="{Binding CanEditRows}"
                    BorderThickness="0"
                    Background="Transparent"
                    Style="{StaticResource SettingsListStyle}"
                    ItemsSource="{Binding VisibleRows}"
                    ItemContainerStyle="{StaticResource ManagerChildItemStyle}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid
            Grid.Row="4"
            Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ManagerWarningBrush}"
                TextWrapping="Wrap"
                Text="{Binding GeneralMessage}"
                Visibility="{Binding HasGeneralMessage, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                Grid.Column="1"
                MinWidth="130"
                Margin="0,0,16,0"
                Appearance="Primary"
                IsEnabled="False"
                Content="{Binding ProcessText}"
                ToolTip="{me:LocalizationSource Manager.NotImplemented}"
                ToolTipService.ShowOnDisabled="True" />
            <ui:Button
                Grid.Column="2"
                MinWidth="130"
                Content="{me:LocalizationSource Manager.Close}"
                Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</core:WpfUIPlatformWindow>
