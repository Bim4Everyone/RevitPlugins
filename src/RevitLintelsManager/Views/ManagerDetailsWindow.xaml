<Window
    x:Class="RevitLintelsManager.Views.ManagerDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    Title="{Binding Title}"
    Width="650"
    MinHeight="0"
    MaxHeight="600"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="Transparent"
    BorderThickness="0"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontSize="16"
    UseLayoutRounding="True"
    PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="ManagerStatusStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Template>
        <ControlTemplate
            TargetType="Window">
            <AdornerDecorator>
                <ContentPresenter />
            </AdornerDecorator>
        </ControlTemplate>
    </Window.Template>
    <Border
        x:Name="DetailsFrame"
        CornerRadius="14"
        BorderThickness="1"
        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        SizeChanged="OnFrameSizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="DetailsHeader"
                Height="64"
                Margin="20,0,8,0"
                Background="Transparent"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="40" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="40" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    x:Name="HeaderIcon"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="28">
                    <ui:SymbolIcon.Style>
                        <Style
                            TargetType="ui:SymbolIcon"
                            BasedOn="{StaticResource ManagerStatusIconStyle}">
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsWarnings}"
                                    Value="False">
                                    <Setter
                                        Property="Symbol"
                                        Value="Info24" />
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock
                    x:Name="HeaderTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style
                            TargetType="TextBlock">
                            <Setter
                                Property="Foreground"
                                Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsWarnings}"
                                    Value="True">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource ManagerSuccessBrush}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding IsWarnings}"
                                            Value="True" />
                                        <Condition
                                            Binding="{Binding HasWarnings}"
                                            Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource ManagerWarningBrush}" />
                                </MultiDataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsAnalysisPending}"
                                    Value="True">
                                    <Setter
                                        Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    ToolTip="{me:LocalizationSource Manager.Close}"
                    AutomationProperties.Name="{me:LocalizationSource Manager.Close}"
                    Click="OnCloseClicked">
                    <Button.Template>
                        <ControlTemplate
                            TargetType="Button">
                            <Border
                                x:Name="CloseBackground"
                                CornerRadius="4"
                                Background="Transparent">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
                                    Property="IsMouseOver"
                                    Value="True">
                                    <Setter
                                        TargetName="CloseBackground"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon
                        Symbol="Dismiss24"
                        FontSize="20"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Button>
            </Grid>
            <ScrollViewer
                Grid.Row="1"
                Margin="20,8,20,20"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Margin="0,0,12,0">
                    <StackPanel
                        Visibility="{Binding IsWarnings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,6"
                            Text="{me:LocalizationSource Manager.StatusElement}"
                            FontSize="16" />
                        <TextBlock
                            Margin="0,0,0,20"
                            TextWrapping="Wrap"
                            Text="{Binding Subject}"
                            FontSize="16" />
                    </StackPanel>
                    <ItemsControl
                        ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="160" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="0,0,16,0"
                                        TextWrapping="Wrap"
                                        Text="{Binding Label}"
                                        FontSize="16" />
                                    <TextBlock
                                        Grid.Column="1"
                                        TextWrapping="Wrap"
                                        Text="{Binding Value}"
                                        FontSize="16" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl
                        ItemsSource="{Binding Descriptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="0,6"
                                    MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="36" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Symbol="ErrorCircle24"
                                        Foreground="{DynamicResource ManagerWarningBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource ManagerWarningBrush}"
                                        TextWrapping="Wrap"
                                        Text="{Binding}"
                                        FontSize="16" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid
                        Margin="0,6"
                        MinHeight="36"
                        Visibility="{Binding IsStatusOk, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="36" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Width="28"
                            Height="28"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Symbol="CheckmarkCircle24"
                            Foreground="{DynamicResource ManagerSuccessBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource ManagerSuccessBrush}"
                            Text="{Binding PositiveMessage}"
                            FontSize="16" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
