<ui:FluentWindow
    x:Class="RevitLintelsManager.Views.ManagerDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore"
    Title="{Binding Title}"
    Width="650"
    MinHeight="0"
    MaxHeight="600"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{Binding Title}"
            Icon="{ui:SymbolIcon Info24}"
            ShowMinimize="False"
            ShowMaximize="False" />
        <ScrollViewer
            Grid.Row="1"
            Margin="20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Text="{Binding Subject}"
                    Visibility="{Binding IsWarnings, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,16,0"
                                    TextWrapping="Wrap"
                                    Text="{Binding Label}" />
                                <TextBlock
                                    Grid.Column="1"
                                    TextWrapping="Wrap"
                                    Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Text="{Binding Status}"
                    Visibility="{Binding IsWarnings, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding ElementWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,4"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,8,0,4"
                    FontWeight="SemiBold"
                    Text="{me:LocalizationSource Manager.RowWarnings}"
                    Visibility="{Binding HasRowWarnings, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding RowWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,4"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    TextWrapping="Wrap"
                    Text="{Binding EmptyWarningsText}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
