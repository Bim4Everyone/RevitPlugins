<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RevitLintelsManager.ViewModels"
    xmlns:models="clr-namespace:RevitLintelsManager.Models"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
            Source="ManagerStatusStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style
        x:Key="ManagerIconButtonStyle"
        TargetType="ui:Button">
        <Setter
            Property="Width"
            Value="22" />
        <Setter
            Property="Height"
            Value="22" />
        <Setter
            Property="MinWidth"
            Value="0" />
        <Setter
            Property="MinHeight"
            Value="0" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="BorderThickness"
            Value="0" />
        <Setter
            Property="Cursor"
            Value="Hand" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="ui:Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">
                            <Setter
                                Property="Opacity"
                                Value="0.7" />
                        </Trigger>
                        <Trigger
                            Property="IsKeyboardFocused"
                            Value="True">
                            <Setter
                                Property="Opacity"
                                Value="0.7" />
                        </Trigger>
                        <Trigger
                            Property="IsEnabled"
                            Value="False">
                            <Setter
                                Property="Opacity"
                                Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ManagerChildItemStyle"
        TargetType="ListBoxItem">
        <Setter
            Property="Margin"
            Value="0,0,12,0" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Stretch" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="ListBoxItem">
                    <ContentPresenter
                        HorizontalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate
        DataType="{x:Type vm:ManagerElementViewModel}">
        <Border
            MinWidth="0"
            Height="36"
            Padding="8,0"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ElementName"
                    VerticalAlignment="Center"
                    Text="{Binding TypeName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding TypeName}" />
                <ui:Button
                    x:Name="InformationButton"
                    Grid.Column="1"
                    Margin="4,0"
                    Padding="0"
                    Style="{StaticResource ManagerIconButtonStyle}"
                    Command="{Binding DataContext.ShowInformationCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding InformationToolTip}">
                    <ui:SymbolIcon
                        Symbol="Info24"
                        FontSize="20"
                        ToolTip="{Binding InformationToolTip}" />
                </ui:Button>
                <ui:Button
                    Grid.Column="2"
                    Padding="0"
                    Style="{StaticResource ManagerIconButtonStyle}"
                    Command="{Binding DataContext.ShowWarningsCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding StatusToolTip}">
                    <ui:SymbolIcon
                        x:Name="StatusIcon"
                        VerticalAlignment="Center"
                        Style="{StaticResource ManagerStatusIconStyle}"
                        ToolTip="{Binding StatusToolTip}" />
                </ui:Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger
                Binding="{Binding ShowInformation}"
                Value="False">
                <Setter
                    TargetName="InformationButton"
                    Property="Visibility"
                    Value="Collapsed" />
            </DataTrigger>
            <DataTrigger
                Binding="{Binding IsMissing}"
                Value="True">
                <Setter
                    TargetName="ElementName"
                    Property="Foreground"
                    Value="{DynamicResource ManagerWarningBrush}" />
                <Setter
                    TargetName="InformationButton"
                    Property="Visibility"
                    Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:ManagerGroupViewModel}">
        <edits:CustomGroupEditControl
            Margin="0,8,0,0"
            ContentPadding="0"
            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
            <edits:CustomGroupEditControl.HeaderContent>
                <Grid
                    MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="30" />
                        <ColumnDefinition
                            Width="48" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="112" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Width="24"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsThreeState="False" />
                    <ui:Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        IsEnabled="False"
                        ToolTip="{me:LocalizationSource Manager.Navigate}">
                        <ui:SymbolIcon
                            Symbol="Search24"
                            FontSize="20"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button>
                    <ContentControl
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{Binding Opening}" />
                    <ContentControl
                        Grid.Column="3"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{Binding Lintel}" />
                    <Grid
                        Grid.Column="4"
                        VerticalAlignment="Center">
                        <ComboBox
                            Height="40"
                            Padding="10,4"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding Actions}"
                            DisplayMemberPath="Title"
                            SelectedItem="{Binding SelectedAction, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="12,0,32,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Text="{Binding MixedActionsText}"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock
                        Grid.Column="5"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding CountText}"
                        ToolTip="{Binding CountText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </edits:CustomGroupEditControl.HeaderContent>
        </edits:CustomGroupEditControl>
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:ManagerItemViewModel}">
        <Border
            Margin="10,0,10,0"
            Padding="0,0,12,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Style>
                <Style
                    TargetType="Border">
                    <Setter
                        Property="BorderThickness"
                        Value="1,0,1,0" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsLastInGroup}"
                            Value="True">
                            <Setter
                                Property="BorderThickness"
                                Value="1,0,1,1" />
                            <Setter
                                Property="CornerRadius"
                                Value="0,0,4,4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid
                Margin="16,6,48,6"
                MinHeight="40"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="30" />
                    <ColumnDefinition
                        Width="48" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="112" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    Width="24"
                    MinWidth="0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsThreeState="False" />
                <ui:Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Appearance="Primary"
                    IsEnabled="False"
                    ToolTip="{me:LocalizationSource Manager.Navigate}">
                    <ui:SymbolIcon
                        Symbol="Search24"
                        FontSize="20"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </ui:Button>
                <ContentControl
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Content="{Binding Opening}" />
                <ContentControl
                    Grid.Column="3"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Content="{Binding Lintel}" />
                <ComboBox
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Height="40"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding Actions}"
                    DisplayMemberPath="Title"
                    SelectedItem="{Binding SelectedAction, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
