<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:RevitLintelsManager.ViewModels"
    xmlns:models="clr-namespace:RevitLintelsManager.Models"
    xmlns:edits="clr-namespace:RevitLintelsManager.Views.Edits"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:me="clr-namespace:dosymep.WpfCore.MarkupExtensions;assembly=dosymep.WpfCore">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
            Source="Edits/CustomGroupEditControl.xaml" />
        <ResourceDictionary
            Source="ManagerStatusStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <system:Double x:Key="ManagerRowFieldHeight">36</system:Double>
    <system:Double x:Key="ManagerActionColumnMinWidth">250</system:Double>
    <Style
        x:Key="ManagerColumnHeaderStyle"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style
        x:Key="ManagerFilterLabelStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="ManagerFilterButtonStyle"
        TargetType="RadioButton">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="Frame"
                                Property="Background"
                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter
                                TargetName="Frame"
                                Property="Background"
                                Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ManagerGroupFrameStyle"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GroupStatus}" Value="{x:Static models:ManagerElementStatus.Fixed}">
                <Setter Property="BorderBrush" Value="{DynamicResource ManagerFixedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GroupStatus}" Value="{x:Static models:ManagerElementStatus.Warning}">
                <Setter Property="BorderBrush" Value="{DynamicResource ManagerWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GroupStatus}" Value="{x:Static models:ManagerElementStatus.Correct}">
                <Setter Property="BorderBrush" Value="{DynamicResource ManagerSuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ManagerGroupControlStyle"
        BasedOn="{StaticResource {x:Type edits:CustomGroupEditControl}}"
        TargetType="edits:CustomGroupEditControl">
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding GroupStatus}" Value="{x:Static models:ManagerElementStatus.Fixed}">
                <Setter Property="BorderBrush" Value="{DynamicResource ManagerFixedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GroupStatus}" Value="{x:Static models:ManagerElementStatus.Warning}">
                <Setter Property="BorderBrush" Value="{DynamicResource ManagerWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding GroupStatus}" Value="{x:Static models:ManagerElementStatus.Correct}">
                <Setter Property="BorderBrush" Value="{DynamicResource ManagerSuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ManagerNavigateButtonStyle"
        TargetType="ui:Button">
        <Setter Property="Width" Value="{DynamicResource CheckBoxWidth}" />
        <Setter Property="Height" Value="{DynamicResource CheckBoxHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter
                            x:Name="Glyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ManagerIconButtonStyle"
        TargetType="ui:Button">
        <Setter
            Property="Width"
            Value="22" />
        <Setter
            Property="Height"
            Value="22" />
        <Setter
            Property="MinWidth"
            Value="0" />
        <Setter
            Property="MinHeight"
            Value="0" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="BorderThickness"
            Value="0" />
        <Setter
            Property="Cursor"
            Value="Hand" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="ui:Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">
                            <Setter
                                Property="Opacity"
                                Value="0.7" />
                        </Trigger>
                        <Trigger
                            Property="IsKeyboardFocused"
                            Value="True">
                            <Setter
                                Property="Opacity"
                                Value="0.7" />
                        </Trigger>
                        <Trigger
                            Property="IsEnabled"
                            Value="False">
                            <Setter
                                Property="Opacity"
                                Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ManagerChildItemStyle"
        TargetType="ListBoxItem">
        <Setter
            Property="Margin"
            Value="0,0,12,0" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Stretch" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="ListBoxItem">
                    <ContentPresenter
                        HorizontalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate
        DataType="{x:Type vm:ManagerElementViewModel}">
        <Border
            MinWidth="0"
            Height="{StaticResource ManagerRowFieldHeight}"
            Padding="8,0"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ElementName"
                    VerticalAlignment="Center"
                    Style="{StaticResource ManagerElementCaptionStyle}"
                    Text="{Binding TypeName}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.ToolTip>
                        <ToolTip
                            Content="{Binding PlacementTarget.DataContext.TypeName, RelativeSource={RelativeSource Self}}"
                            Foreground="{Binding PlacementTarget.Foreground, RelativeSource={RelativeSource Self}}" />
                    </TextBlock.ToolTip>
                </TextBlock>
                <ui:Button
                    x:Name="InformationButton"
                    Grid.Column="1"
                    Margin="4,0"
                    Padding="0"
                    Style="{StaticResource ManagerIconButtonStyle}"
                    Command="{Binding DataContext.ShowInformationCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding InformationToolTip}">
                    <ui:SymbolIcon
                        x:Name="InformationIcon"
                        Symbol="Info24"
                        FontSize="20"
                        ToolTip="{Binding InformationToolTip}" />
                </ui:Button>
                <ui:Button
                    x:Name="StatusButton"
                    Grid.Column="2"
                    Padding="0"
                    Style="{StaticResource ManagerIconButtonStyle}"
                    Command="{Binding DataContext.ShowWarningsCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding StatusToolTip}">
                    <ui:SymbolIcon
                        x:Name="StatusIcon"
                        VerticalAlignment="Center"
                        Style="{StaticResource ManagerStatusIconStyle}"
                        ToolTip="{Binding StatusToolTip}" />
                </ui:Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger
                Binding="{Binding ShowStatus}"
                Value="False">
                <Setter
                    TargetName="StatusButton"
                    Property="Visibility"
                    Value="Collapsed" />
            </DataTrigger>
            <DataTrigger
                Binding="{Binding ShowInformation}"
                Value="False">
                <Setter
                    TargetName="InformationButton"
                    Property="Visibility"
                    Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFixed}" Value="True">
                <Setter TargetName="InformationIcon" Property="Foreground" Value="{DynamicResource ManagerFixedBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsLintelNotRequired}" Value="True" />
                    <Condition Binding="{Binding IsFixed}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="StatusIcon" Property="Symbol" Value="CheckmarkCircle24" />
                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ManagerSuccessBrush}" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:ManagerGroupViewModel}">
        <edits:CustomGroupEditControl
            Margin="10,8,10,0"
            Style="{StaticResource ManagerGroupControlStyle}"
            ContentPadding="0"
            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
            <edits:CustomGroupEditControl.HeaderContent>
                <Grid
                    MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="30" />
                        <ColumnDefinition
                            Width="48" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            MinWidth="{StaticResource ManagerActionColumnMinWidth}"
                            Width="*" />
                        <ColumnDefinition
                            Width="144" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Width="24"
                        MinWidth="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsThreeState="False" />
                    <ui:Button
                        Grid.Column="1"
                        Style="{StaticResource ManagerNavigateButtonStyle}"
                        Command="{Binding DataContext.NavigateCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        ToolTip="{me:LocalizationSource Manager.Navigate}">
                        <ui:SymbolIcon
                            Symbol="Search24"
                            FontSize="16" />
                    </ui:Button>
                    <ContentControl
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{Binding Opening}" />
                    <ContentControl
                        Grid.Column="3"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{Binding Lintel}" />
                    <Grid
                        Grid.Column="4"
                        VerticalAlignment="Center">
                        <ComboBox
                            Height="{StaticResource ManagerRowFieldHeight}"
                            Padding="10,7.5"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding Actions}"
                            DisplayMemberPath="Title"
                            SelectedItem="{Binding SelectedAction, Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="12,0,32,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Text="{Binding MixedActionsText}"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock
                        Grid.Column="5"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding CountText}"
                        ToolTip="{Binding CountText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </edits:CustomGroupEditControl.HeaderContent>
        </edits:CustomGroupEditControl>
    </DataTemplate>
    <DataTemplate
        DataType="{x:Type vm:ManagerItemViewModel}">
        <Border
            Margin="10,0,10,0"
            Padding="0,0,12,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Border.Style>
                <Style
                    TargetType="Border"
                    BasedOn="{StaticResource ManagerGroupFrameStyle}">
                    <Setter
                        Property="BorderThickness"
                        Value="1,0,1,0" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsLastInGroup}"
                            Value="True">
                            <Setter
                                Property="BorderThickness"
                                Value="1,0,1,1" />
                            <Setter
                                Property="CornerRadius"
                                Value="0,0,4,4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid
                Margin="16,6,48,6"
                MinHeight="40"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="30" />
                    <ColumnDefinition
                        Width="48" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        MinWidth="{StaticResource ManagerActionColumnMinWidth}"
                        Width="*" />
                    <ColumnDefinition
                        Width="112" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    Width="24"
                    MinWidth="0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsThreeState="False" />
                <ui:Button
                    Grid.Column="1"
                    Style="{StaticResource ManagerNavigateButtonStyle}"
                    Command="{Binding DataContext.NavigateCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{me:LocalizationSource Manager.Navigate}">
                    <ui:SymbolIcon
                        Symbol="Search24"
                        FontSize="16" />
                </ui:Button>
                <ContentControl
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Content="{Binding Opening}" />
                <ContentControl
                    Grid.Column="3"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Content="{Binding Lintel}" />
                <ComboBox
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Height="{StaticResource ManagerRowFieldHeight}"
                    Padding="10,7.5"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding Actions}"
                    DisplayMemberPath="Title"
                    SelectedItem="{Binding SelectedAction, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
