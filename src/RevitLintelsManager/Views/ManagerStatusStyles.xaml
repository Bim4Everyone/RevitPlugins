<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <SolidColorBrush
        x:Key="ManagerWarningBrush"
        Color="Orange" />
    <SolidColorBrush
        x:Key="ManagerSuccessBrush"
        Color="#279B70" />
    <SolidColorBrush
        x:Key="ManagerFixedBrush"
        Color="#A3653D" />
    <Style x:Key="ManagerElementCaptionStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStatusPlaceholder}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ManagerWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLintelNotRequired}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ManagerSuccessBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsStatusPlaceholder}" Value="True" />
                    <Condition Binding="{Binding IsFixed}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource ManagerFixedBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ManagerStatusIconStyle"
        TargetType="ui:SymbolIcon">
        <Setter
            Property="FontSize"
            Value="20" />
        <Setter
            Property="Symbol"
            Value="CheckmarkCircle24" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource ManagerSuccessBrush}" />
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding IsAnalysisPending}"
                Value="True">
                <Setter
                    Property="Symbol"
                    Value="QuestionCircle24" />
                <Setter
                    Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </DataTrigger>
            <DataTrigger
                Binding="{Binding HasWarnings}"
                Value="True">
                <Setter
                    Property="Symbol"
                    Value="ErrorCircle24" />
                <Setter
                    Property="Foreground"
                    Value="{DynamicResource ManagerWarningBrush}" />
            </DataTrigger>
            <DataTrigger
                Binding="{Binding IsFixed}"
                Value="True">
                <Setter
                    Property="Symbol"
                    Value="LockClosed24" />
                <Setter
                    Property="Foreground"
                    Value="{DynamicResource ManagerFixedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
