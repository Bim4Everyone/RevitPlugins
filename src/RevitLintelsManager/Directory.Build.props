<Project>
    <Import Project="..\Directory.Build.props" />

    <PropertyGroup>
        <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj\$(RevitVersion)\</BaseIntermediateOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
