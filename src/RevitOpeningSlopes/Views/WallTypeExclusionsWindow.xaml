<base:PlatformWindow
    x:Class="RevitOpeningSlopes.Views.WallTypeExclusionsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:dosymep.WPF.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:RevitOpeningSlopes.ViewModels"
    Title="Исключения типоразмеров стен"
    Width="600"
    Height="500"
    MinWidth="500"
    MinHeight="350"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vms:WallTypeExclusionsViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0 0 0 10"
            Text="Добавленные типоразмеры стен не будут учитываться при формировании Solid вокруг окна."
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="1"
            Margin="0 0 0 10"
            Orientation="Horizontal">
            <Button
                Width="100"
                Height="26"
                Margin="0 0 10 0"
                Content="Добавить"
                Command="{Binding AddWallTypeCommand}" />
            <Button
                Width="140"
                Height="26"
                Content="Указать в модели"
                Click="ButtonSelectInModel_Click" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="8"
            BorderBrush="Gray"
            BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Exclusions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 0 0 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Height="26"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding DataContext.WallTypes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    SelectedItem="{Binding SelectedWallType, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="26"
                                    Margin="8 0 0 0"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    FontSize="16"
                                    Content="-"
                                    Command="{Binding DataContext.RemoveWallTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0 0 10 0"
                    Content="ОК"
                    IsDefault="True"
                    Click="ButtonOk_Click" />
                <Button
                    Width="80"
                    Content="Отмена"
                    IsCancel="True"
                    Click="ButtonCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</base:PlatformWindow>
